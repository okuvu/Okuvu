generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(uuid())
  /// Nullable: therapist-portal wireframes' Add-Client wizard creates a
  /// placeholder User row (email/phone from intake) BEFORE the client has
  /// ever opened the app — every prior User was mobile-signup-first, where
  /// this was always known immediately. Populated by POST /invites/redeem
  /// once the client completes Cognito phone-OTP sign-in for the first time.
  /// Still unique — Postgres treats multiple NULLs as distinct, so this
  /// doesn't weaken the constraint for rows that do have one.
  auth_subject        String?             @unique
  /// Optional as of 20261102_portal_p0_safety_plumbing. Email is the
  /// identity for every client the therapist portal registers (Google
  /// sign-in binds on it), and the portal's Add-client form no longer
  /// collects a phone number at all. The column stays because the legacy
  /// phone-OTP sign-in path (auth-otp.ts, /invites/redeem), the therapist
  /// console's phone search and account.ts's erasure sweep still read it.
  /// A full drop is a later migration, once OTP is retired.
  phone_number        String?
  /// Therapist-portal wireframes C-01 — dual-channel OTP invite (phone +
  /// email both required at wizard step 1). Null for pre-wizard users.
  email               String?
  /// Therapist-portal wireframes C-01 — the therapist's own record of the
  /// client's legal name, for portal display only. Distinct from
  /// ClinicalConfig.display_abbreviation, which is what the client sees
  /// of themselves in the app.
  full_name           String?
  date_of_birth       DateTime?
  /// The CLIENT's own 18+ attestation, set from the app at first sign-in
  /// (contract: docs/app-contracts/age-attestation.md). Confirmed and
  /// declined are separate timestamps rather than a boolean so the
  /// therapist-facing record can say *when* — an age refusal that carries no
  /// time reads as a guess. Declined means the account never activates and
  /// the therapist's roster row reads "Couldn't activate: age".
  age_confirmed_at    DateTime?
  age_declined_at     DateTime?
  gender              String?
  /// The client's system-generated record number, minted once at registration
  /// and never rewritten: `<initials><birth YY><gender letter><serial>`, e.g.
  /// `SG88F0001`. Initials are the first letter of the first and last word of
  /// `full_name` (a single word gets `X` as its second letter); the gender
  /// letter is M, F or X; the serial is global and padded to four digits.
  ///
  /// Nullable because two things legitimately have no number yet: rows that
  /// predate the scheme and are missing a birth year or gender (the admin
  /// console fixes those in place), and client rows created by a path that
  /// never asked for a name. `lib/client-code.ts` owns the rules; this column
  /// only stores the result. Frozen on purpose — see docs/portal-client-id.md.
  client_code         String?             @unique
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// OKUVU v2.0: english (default) | mirror (adaptive Hinglish). Set via
  /// GET/PATCH /settings/language — apps/mobile's Settings > Language screen.
  language_mode       LanguageMode        @default(english)
  /// okuvu-remaining-changes.md O6: quote-of-day, opt-in. Content today is
  /// a small placeholder list per care plan (apps/api's quote-of-day.ts) —
  /// swap for a real source once one is decided; the toggle/plumbing is real.
  quote_of_day_enabled Boolean            @default(false)
  /// Settings > Notifications toggles. `appointment_reminders_enabled` is read
  /// at write time by the therapist portal: it gates appointment notification
  /// rows *and* the email that hangs off them, so one switch covers both
  /// surfaces. `chat_nudges_enabled` is still preference-capture only — nothing
  /// reads it, because nothing nudges yet.
  appointment_reminders_enabled Boolean   @default(true)
  chat_nudges_enabled Boolean             @default(true)
  clinical_config     ClinicalConfig?
  emergency_contact   EmergencyContact?
  engagement_profile  EngagementProfile?
  user_memory         UserMemory?
  mood_logs           MoodLog[]
  safety_state        SafetyState?
  session_logs        SessionLog[]
  session_summaries   SessionSummary[]
  assigned_therapists TherapistClient[]
  notes_received      TherapistNote[]     @relation("ClientToNote")
  turns               Turn[]
  journal_entries     JournalEntry[]
  access_logs         ClinicalAccessLog[] @relation("ClientToAccessLog")
  homeworks           Homework[]          @relation("ClientToHomework")
  reminders           Reminder[]
  appointments        Appointment[]       @relation("ClientToAppointment")
  notifications       Notification[]      @relation("ClientToNotification")
  invite_tokens       InviteToken[]
  tool_preferences    UserToolPreference[]
  safety_flags        SafetyFlag[]
  worksheet_responses WorksheetResponse[] @relation("ClientToWorksheetResponse")
  treasure_collections TreasureCollection[] @relation("ClientToTreasureCollection")
  treasure_notes      TreasureNote[]      @relation("ClientToTreasureNote")
  safety_plan         SafetyPlan?         @relation("ClientToSafetyPlan")
  safety_rechecks     SafetyRecheck[]     @relation("ClientToSafetyRecheck")
}

/// The single global counter behind `User.client_code`'s four-digit serial.
///
/// A row rather than `count(client_code) + 1`: two registrations a moment
/// apart would both read the same count and collide on the unique index.
/// Incrementing one locked row inside the creation transaction serialises
/// them, and the row survives deletions, so a removed client's number is
/// never reissued to someone else.
model ClientCodeSequence {
  /// Fixed value, `client_code` — one row, so there is nothing to vary.
  id         String @id
  last_value Int    @default(0)
}

model Therapist {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  image              String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  client_assignments TherapistClient[]
  notes              TherapistNote[]     @relation("TherapistToNote")
  access_logs        ClinicalAccessLog[]
  homeworks_assigned Homework[]          @relation("TherapistToHomework")
  appointments       Appointment[]       @relation("TherapistToAppointment")
  invite_tokens      InviteToken[]
}

model ClinicalConfig {
  id                       String          @id @default(uuid())
  user_id                  String          @unique
  care_plan_id             CarePlan
  assignment_state         AssignmentState @default(provisional)
  created_at               DateTime        @default(now())
  confidence_at_last_eval  Float?
  turns_evaluated          Int             @default(0)
  reasoning_note           String?
  care_plan_review_flagged Boolean         @default(false)
  /// OKUVU v2.0: therapist-authored free text steering A2's
  /// ${care_plan_focus} — replaces gating A2's prompt on the bare CP1/2/3
  /// label. Null until the portal gets a write path for it (out of scope
  /// this pass); agent-context.ts falls back to a generic label derived
  /// from care_plan_id until then.
  care_plan_focus          String?
  /// Therapist-portal wireframes C-02 — step 2, "brief history," all
  /// optional. Never shown to the client.
  presenting_issues        String[]        @default([])
  /// Therapist-portal wireframes C-04 — step 4's welcome note, rendered on
  /// the mobile app's new onboarding welcome screen at first run.
  welcome_note             String?
  /// Therapist-portal wireframes C-04 — step 4's display abbreviation
  /// (e.g. "S." from "Shubhangi"), editable by the client at first run.
  display_abbreviation     String?
  user                     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model SafetyState {
  id                               String           @id @default(uuid())
  user_id                          String           @unique
  safety_state_current             SafetyStateEnum
  safety_state_at_last_session_end SafetyStateEnum?
  updated_at                       DateTime         @updatedAt
  user                             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// One therapist-visible safety event. `SafetyState` is current-state only
/// (one row per user, overwritten each turn), so it cannot answer "what
/// happened, when, and has anyone looked at it" — which is the whole of the
/// portal's Safety card. Written by apps/api/src/lib/safety-flags.ts at the
/// moment an S3 or S4 turn is persisted.
///
/// Deliberately owns no message content: the card must show the event, never
/// the conversation. `source` names which screen the client received so the
/// therapist can be told the crisis card was actually shown.
///
/// Acknowledgement is permanent by construction — no code path clears
/// `acknowledged_at` (see the safety router's acknowledge mutation).
model SafetyFlag {
  id                        String          @id @default(uuid())
  user_id                   String
  level                     SafetyFlagLevel
  occurred_at               DateTime        @default(now())
  /// The S3 grounding card / S4 crisis card served for this turn. Always
  /// true today; a column rather than an assumption so a future
  /// detect-only path cannot silently claim a screen was shown.
  crisis_screen_shown       Boolean         @default(true)
  /// Which deterministic screen the client saw.
  source                    String?
  session_id                String?
  /// The assistant Turn row this flag belongs to, when one exists. Unique:
  /// one turn produces at most one flag, so a retried insert cannot
  /// double-count a single crisis as two events.
  turn_id                   String?         @unique
  /// Non-chat writes that must go through the same check (journal entry,
  /// worksheet answer, Treasure Box note) have no Turn row, so they record the
  /// content they came from here. TEXT ONLY — never the content itself: the
  /// flag exists to tell the therapist an event happened and which screen the
  /// client was on, exactly as it does for chat. Unique per subject so a
  /// retried write cannot double-count one crisis; subject_id is null for chat.
  subject_kind              String?
  subject_id                String?
  acknowledged_at           DateTime?
  acknowledged_by_therapist_id String?
  user                      User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([subject_kind, subject_id])
  @@index([user_id, occurred_at])
  @@index([user_id, acknowledged_at])
}

enum SafetyFlagLevel {
  S3
  S4
}

/// A client write the safety check could not screen.
///
/// When the classifier is unreachable or slow, the write is saved and the
/// client is offered help — but nothing is claimed and nobody is alerted, on
/// purpose: a crisis card on every outage would train therapists to ignore the
/// real ones (owner's rule, 9 Nov 2026). This row is the promise that the text
/// gets looked at again once the service answers, and the only thing that can
/// raise an alert afterwards.
///
/// It stores a POINTER, never the content: `subject_kind` + `subject_id` name
/// the journal entry, worksheet response or Treasure note, and the recheck
/// re-reads that row. Deleting the client's row is what removes the text; this
/// queue row goes with it (cascade), so an erasure request cannot leave
/// unscreened text referenced by a queue.
model SafetyRecheck {
  id              String    @id @default(uuid())
  user_id         String
  /// Which surface the write came from: journal_entry | worksheet_answer |
  /// treasure_note. Identical vocabulary to SafetyFlag.source.
  surface         String
  subject_kind    String
  subject_id      String
  /// Bumped on each attempt that still could not reach a verdict.
  attempts        Int       @default(0)
  next_attempt_at DateTime  @default(now())
  /// Set when the sweep gave up (the classifier stayed down past the window).
  /// The row is kept rather than deleted: "we never managed to screen this" is
  /// a fact worth being able to query after the fact.
  abandoned_at    DateTime?
  created_at      DateTime  @default(now())
  user            User      @relation("ClientToSafetyRecheck", fields: [user_id], references: [id], onDelete: Cascade)

  /// One queue row per write: a retried save cannot enqueue the same row twice.
  @@unique([subject_kind, subject_id])
  @@index([next_attempt_at])
  @@index([user_id, created_at])
}

model SessionLog {
  id                     String                      @id @default(uuid())
  user_id                String
  session_started_at     DateTime                    @default(now())
  session_ended_at       DateTime?
  turn_count             Int                         @default(0)
  session_feedback_score Int?
  crisis_flag_detected   Boolean                     @default(false)
  summary_embedding      Unsupported("vector(768)")?
  user                   User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  summaries              SessionSummary[]
  turns                  Turn[]

  @@index([user_id, session_started_at(sort: Desc)])
}

model Turn {
  id             String     @id @default(uuid())
  session_id     String
  user_id        String
  turn_number    Int
  role           String
  content        String
  is_a9_fallback Boolean    @default(false)
  // Which model/prompt version actually produced `content` (assistant turns
  // only — user turns have no model involved). Null when no model call
  // completed for this turn, or when A9-post substituted a static
  // getSafeFallback() string over A2's output (see orchestrator.ts's
  // turnModelVersion/turnPromptVersion comments) — content that isn't
  // actually model-produced should not be attributed to one.
  model_version  String?
  prompt_version String?
  // OKUVU — Plumbing Fixes & Rationale v1.0, A4: which mechanism produced a
  // substitute reply (assistant turns only). Null on every turn whose content
  // is genuinely A2's model output; set whenever a static response replaced
  // or degraded the real one:
  //   'a2_degraded'      — A2 itself timed out / errored (A2_DEGRADED_RESPONSE)
  //   'a9_pre_blocked'   — A8 routed mode='blocked' (A9_PRE_BLOCKED_RESPONSE)
  //   'a9_post_blocked'  — A9-post BLOCKED and substituted getSafeFallback()
  //   'a9_post_unavailable' — A9-post call failed at S2 and fail-closed
  //   'deterministic_grounding' — A8 routed agent='deterministic-grounding'
  // Persisted alongside (not instead of) `fallback_used` — that flag must
  // now be true for every one of these paths (A4's "telemetry lies on
  // blocks" fix), so the scorecard's zero-tolerance fallback count is honest.
  fallback_source String?
  // A2's own S-07 signal (assistant turns only) — okuvu-remaining-changes.md
  // §B.2/§C.2: previously computed by the LLM every turn and discarded
  // entirely, no consumer read them. Persisted here so a future pass has
  // data to build on; no consumer logic (auto-close, report card, therapist
  // notifications) exists yet.
  taper_state         String  @default("none")
  closure_offered     Boolean @default(false)
  frustration_event   Boolean @default(false)
  homework_referenced Boolean @default(false)
  therapist_referral  Boolean @default(false)
  created_at     DateTime   @default(now())
  session        SessionLog @relation(fields: [session_id], references: [id])
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([session_id, turn_number, role])
  @@index([session_id, turn_number])
  @@index([user_id, created_at(sort: Desc)])
}

model SessionSummary {
  id                String        @id @default(uuid())
  user_id           String
  session_id        String
  summary_text      String?
  last_updated_turn Int
  last_updated_at   DateTime      @updatedAt
  created_at        DateTime      @default(now())
  status            SummaryStatus @default(PENDING)
  session           SessionLog    @relation(fields: [session_id], references: [id])
  user              User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, session_id])
  @@index([user_id, created_at(sort: Desc)])
}

model EngagementProfile {
  id                 String    @id @default(uuid())
  user_id            String    @unique
  current_streak     Int       @default(0)
  longest_streak     Int       @default(0)
  last_session_date  DateTime?
  voice_mode_enabled Boolean   @default(false)
  consent_1          Boolean   @default(false)
  consent_2          Boolean   @default(false)
  consent_3          Boolean   @default(false)
  consent_4          Boolean   @default(false)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserMemory {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  life_context       String[]
  recurring_themes   String[]
  what_helps         String[]
  what_doesnt_help   String[]
  significant_events String[]
  current_stressors  String[]
  /// OKUVU v2.0: assigned homework + the user's reported outcome, tagged by
  /// session (e.g. "grounding before bed — not_done, forgot [session 5]").
  homework_track     String[]
  emotional_baseline String?

  session_count Int @default(0)

  created_at   DateTime @default(now())
  last_updated DateTime @updatedAt

  @@index([user_id])
}

model TherapistNote {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  note_text      String
  created_at     DateTime  @default(now())
  client         User      @relation("ClientToNote", fields: [client_user_id], references: [id], onDelete: Cascade)
  therapist      Therapist @relation("TherapistToNote", fields: [therapist_id], references: [id])

  @@index([client_user_id, created_at(sort: Desc)])
}

model TherapistClient {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  created_at     DateTime  @default(now())
  /// The therapist's OWN label for this client — the only name the portal
  /// shows. Lives here, not on User, because it is per-relationship (two
  /// therapists may label the same person differently) and because the
  /// client's own display name is a separate, client-owned field:
  /// ClinicalConfig.display_abbreviation. Neither side ever sees the other's.
  /// Never included in any agent prompt — pinned by
  /// apps/api/src/__tests__/agent-context-privacy.test.ts.
  client_label   String
  /// The therapist's own 18+ attestation, captured from the Add-client form
  /// with the therapist who gave it. An audit record, never a gate on its
  /// own: the client attests separately in the app (User.age_confirmed_at),
  /// and a client refusal is what blocks activation.
  age_confirmed_by_therapist_at DateTime?
  age_confirmed_by_therapist_id String?
  /// Registration → invite is a two-step handover while the app is on Play
  /// internal testing: a therapist adding a client does not email them (the
  /// address has to be on the tester list first, or the Play link is a dead
  /// end). `tester_access_added_at` is the operator's "Mark tester access
  /// added" action; `invite_sent_at` is the email that follows it.
  tester_access_added_at DateTime?
  invite_sent_at         DateTime?
  /// OKUVU v2.0: client's consent for this therapist to view raw chat
  /// content (vs. summaries only). Defaults false (opt-in). Enforced on
  /// Report Card, Session Prep, and clients.detail's careReviewFlagged.
  /// Settable via admin.assignClient's Add-Client flow (an admin/therapist
  /// attestation that consent was obtained out-of-band — there is still no
  /// client-facing consent UI). Field name matches
  /// docs/okuvu-v2.0/01-parity-audit-v1.md's own proposal.
  chat_access_granted Boolean @default(false)
  /// Therapist-portal wireframes: set when the therapist clicks "Request
  /// chat access" (clients.requestChatAccess). Cleared by the client's own
  /// grant/deny via PATCH /users/me/chat-access. Null = never requested.
  chat_access_requested_at DateTime?
  /// When the CLIENT approved the request above. The 30-day read-only window
  /// is measured from this timestamp, not from the ask — an ask the client
  /// never answered opens nothing (see clients.ts#chatAccessWindow).
  chat_access_granted_at DateTime?
  /// When the window closed: the client revoked, or the migration that made
  /// approval mandatory closed a window that had only ever been asked for.
  /// The window is half-open on [granted_at, min(granted_at+30d,
  /// closed_at)) — a closed_at in the past closes it immediately.
  chat_access_closed_at  DateTime?
  /// Status lifecycle (wireframes C-07/C-08) is DERIVED, not stored, from
  /// created_at/activated_at/ended_at — see clients.ts's deriveStatus() —
  /// to avoid a redundant field that can drift from the timestamps.
  /// Set the first time this client pulls GET /users/me/today or
  /// /users/me/context after redeeming their invite (markClientActivatedIfNeeded).
  activated_at   DateTime?
  /// Set by clients.end — the therapist removing a client from their
  /// roster. Never deletes the row; keeps full history.
  ended_at       DateTime?
  client         User      @relation(fields: [client_user_id], references: [id], onDelete: Cascade)
  therapist      Therapist @relation(fields: [therapist_id], references: [id])

  @@unique([therapist_id, client_user_id])
  @@index([client_user_id])
}

/// OKUVU v2.0: therapist-assigned homework. Read by A2's ${homework}
/// (agent-context.ts pulls the most recent `active` row's description) and
/// (eventually) Worker 05's homework_progress. Assigned via the portal's
/// Homework page (apps/therapist-portal/.../clients/[id]/homework) — always
/// free-text `description`, optionally also linked to a specific approved
/// exercise via `tool_id` (decisions doc round, 15 Sep 2026 §5) so the
/// client app can render it as a real, playable exercise rather than just
/// prose.
model Homework {
  id             String              @id @default(uuid())
  client_user_id String
  therapist_id   String
  description    String
  tool_id        String?
  /// --- Worksheet assignment fields (Step 1, exercise library work) ---
  /// A worksheet assignment IS a Homework row: it is assigned from the same
  /// portal form, announced by the same Notification, and read by the same
  /// Today card, so it must not get a parallel assignment table. All five are
  /// null for plain-text and exercise homework.
  /// The therapist's personal line, shown to the client above the worksheet.
  personal_note  String?
  /// 'once' | 'once_daily' | 'twice_daily' | 'thrice_daily' | 'as_needed' —
  /// same vocabulary as Reminder.frequency, so one vocabulary for schedules.
  frequency      String?
  due_at         DateTime?
  /// "HH:mm" in IST, for the reminder that will be delivered once a sender
  /// exists. Stored as the time of day rather than a timestamp so it does not
  /// expire; nothing reads it yet (no scheduler — owner's decision, 9 Nov).
  reminder_time  String?
  /// Free-text therapy goal this assignment serves. No goal table exists
  /// (CarePlan is a coarse enum), so this is the therapist's own label.
  therapy_goal   String?
  status         HomeworkStatus      @default(active)
  assigned_at    DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  client         User                @relation("ClientToHomework", fields: [client_user_id], references: [id], onDelete: Cascade)
  therapist      Therapist           @relation("TherapistToHomework", fields: [therapist_id], references: [id])
  tool           ToolRegistryEntry?  @relation(fields: [tool_id], references: [tool_id])
  reminders      Reminder[]
  worksheet_responses WorksheetResponse[]

  @@index([client_user_id, status, assigned_at(sort: Desc)])
}

/// OKUVU v2.0: scheduler source for homework/tool-practice reminders.
/// `schedule_note` stays free text (therapist-authored) alongside the
/// structured `frequency`/`times` fields — those two are read by the
/// Today-card pull API; delivery (push/scheduler) is a separate,
/// out-of-scope-this-pass workstream. `frequency` is a plain string, not an
/// enum, to avoid the CREATE TYPE privilege friction hit earlier this
/// session: one of 'off' | 'once_daily' | 'twice_daily' | 'thrice_daily' |
/// 'as_needed'. `times` holds up to 3 "HH:mm" entries, meaningful only for
/// the *_daily frequencies.
model Reminder {
  id            String             @id @default(uuid())
  user_id       String
  homework_id   String?
  tool_id       String?
  frequency     String             @default("off")
  times         String[]           @default([])
  schedule_note String
  active        Boolean            @default(true)
  created_at    DateTime           @default(now())
  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  homework      Homework?          @relation(fields: [homework_id], references: [id])
  tool          ToolRegistryEntry? @relation(fields: [tool_id], references: [tool_id])

  @@index([user_id, active])
}

// Records every therapist read of a client's clinical data (safety state,
// reasoning note, session summary, session notes) for breach/incident
// forensics. See docs/audit/evia-therapist-portal-audit.md F-05 — there was
// previously no way to answer "who viewed this client's record, and when."
model ClinicalAccessLog {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  action         String
  created_at     DateTime  @default(now())
  therapist      Therapist @relation(fields: [therapist_id], references: [id])
  client         User      @relation("ClientToAccessLog", fields: [client_user_id], references: [id], onDelete: Cascade)

  @@index([client_user_id, created_at(sort: Desc)])
  @@index([therapist_id, created_at(sort: Desc)])
}

/// Therapist-portal wireframes P-01..P-04. Distinct from SessionLog (a
/// chat conversation) — this is a calendar appointment between a
/// therapist and client. Repeat-weekly materializes N independent rows at
/// creation time, not a recurrence-rule field. Reschedule creates a NEW
/// row with rescheduled_from pointing back and sets the old row's
/// cancelled_at (superseded, never deleted). Not gated on
/// chat_access_granted — appointment logistics aren't raw chat content.
/// remind_24h/remind_1h are stored but not acted on yet (no push/SMS
/// infra exists anywhere — see okuvu-remaining-changes.md), matching the
/// wireframe's own "infra incomplete" annotation.
model Appointment {
  id               String    @id @default(uuid())
  therapist_id     String
  client_user_id   String
  scheduled_at     DateTime
  duration_minutes Int       @default(50)
  mode             String    // 'video' | 'phone' | 'in_person'
  location         String?
  note_to_client   String?
  remind_24h       Boolean   @default(false)
  remind_1h        Boolean   @default(false)
  rescheduled_from String?
  cancelled_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  therapist        Therapist @relation("TherapistToAppointment", fields: [therapist_id], references: [id])
  client           User      @relation("ClientToAppointment", fields: [client_user_id], references: [id], onDelete: Cascade)

  @@index([therapist_id, scheduled_at])
  @@index([client_user_id, scheduled_at])
}

/// One row per client-facing event (homework assigned, reminder set,
/// appointment booked / moved / cancelled) — the single source of truth behind
/// the app's bell, unread badge and inbox list.
///
/// One record, several possible readers: the bell and the list read this table,
/// and any delivery channel hangs off the same row — never a parallel pipeline
/// with its own state. Email is the first such sender: the therapist portal's
/// `server/notifications.ts` sends it right after this row is committed, with
/// logistics-only copy (no homework or reminder text), gated by the same
/// appointment-reminders toggle. Push (FCM) does not exist yet, so opening the
/// app is still the only way to see an item if email is missed or fails.
///
/// `title`/`body` are authored server-side at write time and stored, not
/// derived on read, so the wording a client saw in their inbox does not change
/// when a formatter or a translation changes later. Copy rules live in
/// `packages/shared-types/notifications.ts`; nothing clinical from the
/// therapist's private note belongs in either column.
///
/// `kind` is a plain string, deliberately not an enum: the same
/// CREATE TYPE privilege friction that kept `Reminder.frequency` a string
/// applies here, and an unknown kind must degrade to a generic row rather than
/// fail the write that the therapist is waiting on.
model Notification {
  id             String    @id @default(uuid())
  user_id        String
  /// 'homework_assigned' | 'reminder_set' | 'appointment_booked' |
  /// 'appointment_rescheduled' | 'appointment_cancelled'. Read by the app only
  /// to pick an icon and a deep-link target; unknown values render as a
  /// generic row.
  kind           String
  title          String
  body           String
  /// What tapping the row opens. Plain columns rather than a polymorphic
  /// (target_type, target_id) pair so a row can point at the same homework a
  /// reminder refers to without a join table. Both null for kinds with no
  /// destination.
  homework_id    String?
  appointment_id String?
  read_at        DateTime?
  created_at     DateTime  @default(now())
  user           User      @relation("ClientToNotification", fields: [user_id], references: [id], onDelete: Cascade)

  /// The inbox read: newest first for one client.
  @@index([user_id, created_at(sort: Desc)])
  /// The badge count: unread only.
  @@index([user_id, read_at])
}

/// Therapist-portal wireframes C-06 — the Add-Client wizard's provisioning
/// flow: therapist submits → placeholder User + ClinicalConfig +
/// TherapistClient(pending) + this token → Brevo email (+ manual
/// SMS/WhatsApp share of the same link) → client OTP-activates via
/// POST /invites/redeem, which populates User.auth_subject and sets
/// redeemed_at.
/// token_hash, not the plaintext code — the invite code is randomly
/// generated (8 chars, 33-char alphabet), one-directionally hashed
/// (SHA-256) before it's ever written here, and only the plaintext is
/// emailed to the client. Redemption re-hashes the client-submitted code
/// and looks up by that hash, so the DB never holds anything that alone
/// lets a reader redeem an invite.
model InviteToken {
  id             String    @id @default(uuid())
  token_hash     String    @unique
  therapist_id   String
  client_user_id String
  created_at     DateTime  @default(now())
  expires_at     DateTime
  redeemed_at    DateTime?
  therapist      Therapist @relation(fields: [therapist_id], references: [id])
  client         User      @relation(fields: [client_user_id], references: [id], onDelete: Cascade)

  @@index([client_user_id])
}

model EmergencyContact {
  id              String   @id @default(uuid())
  user_id         String   @unique
  encrypted_name  String
  encrypted_phone String
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// S6 (waitlist) — captured when a phone number with no invite/account hits
// /auth/verify-otp's NO_ACCOUNT path, and by the landing page's own form.
// Follow-up (sending an invite) is a manual therapist/ops action against this
// table, not automated.
//
// Copy revision v1 (§13) split the landing form in two: a client asking for a
// place, and a therapist asking for a walkthrough. The extra columns are the
// therapist's answers and are NULL on every client row, so the split is
// backfill-free and the old single-email rows stay valid as `kind = 'client'`.
model WaitlistEntry {
  id            String   @id @default(uuid())
  email         String
  phone_number  String?
  kind          String   @default("client")
  name          String?
  organisation  String?
  caseload      String?
  has_therapist Boolean?
  created_at    DateTime @default(now())
}

model MoodLog {
  id         String   @id @default(uuid())
  user_id    String
  mood_value Int
  /// The two screens the approved document adds after the mood check-in:
  /// what was happening just before, and how strong the feeling is 0-10.
  /// The daily value stays 1-5; the 0-10 intensity is a different measure and
  /// is the one the demanding-worksheet gate reads.
  trigger_text    String?
  intensity_0_10  Int?
  date_ist   DateTime @db.Date
  source     String   @default("user_input")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date_ist])
  @@index([user_id, date_ist(sort: Desc)])
}

model GovernanceLog {
  id              String   @id @default(uuid())
  session_id      String
  turn_number     Int
  gate            String
  decision        String
  violation_type  String?
  confidence      String
  blocked_content String?
  created_at      DateTime @default(now())
}

/// E17-S4 — append-only, tamper-evident audit chain (`apps/api/src/lib/
/// audit-chain.ts`, ported from `reference/python-core/okuvu/audit.py`).
///
/// One row per safety-relevant event. `body` is the exact canonical JSON that
/// was hashed, stored as text rather than JSONB on purpose: jsonb reorders keys
/// and rewrites numbers, and the bytes that were sealed must be the bytes that
/// are verified. `hash = sha256(prev_hash + body)`; `prev_hash` is UNIQUE, so a
/// concurrent append behind the same head is an insert conflict (retried),
/// never a forked chain. `seq` is app-assigned and contiguous from 1 —
/// gap-freeness is part of the verification.
model AuditEvent {
  seq       Int    @id
  actor     String
  action    String
  object    String
  at        String
  body      String
  prev_hash String @unique
  hash      String @unique

  @@index([at])
  @@index([action])
}

enum CarePlan {
  CP1
  CP2
  CP3
}

enum AssignmentState {
  provisional
  confirmed
}

enum SafetyStateEnum {
  S0
  S1
  S2
  S3
  S4
}


model JournalEntry {
  id         String   @id @default(uuid())
  user_id    String
  // Nullable: journaling is the point, labelling the feeling is optional.
  // A client must be able to write and save without picking a mood chip.
  emotion    String?
  intensity  Int?
  content    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
}

/// A completed worksheet. One row per filling-in, not per worksheet — a client
/// may fill the same worksheet again on another day, and an assignment may
/// legitimately be repeated.
///
/// Privacy by construction: there is NO therapist column here. The therapist
/// can only reach a response through (a) `shared_with_therapist = true` AND
/// (b) a live TherapistClient link to this user. Nothing copies a response to a
/// per-therapist row, so revoking the share (setting the boolean false, clearing
/// shared_at) removes it from every therapist's view in the same statement.
///
/// `safety_flagged` is the durable record that the mandated check ran and fired;
/// the text it fired on is never duplicated here, and the corresponding
/// SafetyFlag row carries the event the therapist is told about, with no content.
model WorksheetResponse {
  id             String   @id @default(uuid())
  user_id        String
  /// The worksheet catalogue entry (ToolRegistryEntry.tool_id, kind='worksheet').
  worksheet_id   String
  /// The assignment this answers, when it came from one. Null for a
  /// self-serve worksheet. Kept on delete so a client's writing survives a
  /// therapist tidying their homework list.
  homework_id    String?
  /// Answers keyed by the field ids in the approved content JSON. Free text
  /// lives in here; it is client-authored and always safety-checked on write.
  answers        Json
  /// Optional self-report around the exercise, 0-10, matching the approved
  /// "How are you feeling now?" slider and the above-5 demanding gate. Not a
  /// scored instrument and never labelled as one. The daily mood check-in is
  /// a separate 1-5 scale and is not this field.
  feeling_before Int?
  feeling_after  Int?
  /// Optional free text: "what got in the way" / "whether it helped".
  barriers       String?
  helped         Boolean?
  /// Did the safety check flag any text in `answers`? Recorded, no content.
  safety_flagged Boolean  @default(false)
  /// 'S3' | 'S4' when flagged; the level chat uses, same card is shown.
  safety_level   String?
  /// 'en' | 'hi' — which of content_en/content_hi was filled in.
  language       String   @default("en")
  /// Per-item share (owner decision 6, 9 Nov 2026). Never inferred from
  /// chat access. Default false: not shared unless the client says so.
  shared_with_therapist Boolean @default(false)
  shared_at      DateTime?
  /// Set when the client stops sharing. Kept for the audit trail; visibility
  /// is the boolean, so un-sharing takes effect immediately.
  unshared_at    DateTime?
  completed_at   DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation("ClientToWorksheetResponse", fields: [user_id], references: [id], onDelete: Cascade)
  worksheet      ToolRegistryEntry @relation("WorksheetToResponse", fields: [worksheet_id], references: [tool_id])
  homework       Homework? @relation(fields: [homework_id], references: [id], onDelete: SetNull)

  @@index([user_id, completed_at(sort: Desc)])
  @@index([user_id, shared_with_therapist])
  @@index([worksheet_id])
}

/// The client's safety plan — worksheet 16, "My plan for hard moments".
///
/// Co-created in a session and written BY THE THERAPIST, which is why it is not
/// a `WorksheetResponse`: that table is client-authored and deliberately has no
/// therapist column, so a response can only reach a therapist through a share
/// the client chose. A plan is the other shape — the therapist authors it, the
/// client reads it, and visibility is not a share decision at all. Putting a
/// therapist column on `WorksheetResponse` to express that would weaken a
/// documented invariant of every other worksheet answer.
///
/// The parts, their order and their wording are NOT stored here: they are the
/// approved catalogue body (`ToolRegistryEntry.tool_id = 'ws_safety_plan'`), so
/// a wording change is one row, not one row per client. `answers` holds the
/// client's own words per part id. The helplines in part 5 are never stored —
/// they are read from the central list (`@okuvu/shared-types/safety`) at render
/// time, so a retired number cannot survive inside an old plan.
///
/// One row per client (`user_id` unique): a plan is a living document, edited
/// together, not a series of versions. `created_by_therapist_id` keeps the
/// record of who made it with them.
model SafetyPlan {
  id                      String   @id @default(uuid())
  user_id                 String   @unique
  /// Client's own words, keyed by the catalogue field ids
  /// (signs, on_my_own, people_places, ask_for_help, safer_surroundings,
  /// one_reason).
  answers                 Json
  /// Part 5's therapist half: how this client reaches their own therapist.
  /// Entered by the therapist; the crisis lines beside it are never typed.
  therapist_contact       String?
  created_by_therapist_id String
  updated_by_therapist_id String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  user                    User     @relation("ClientToSafetyPlan", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([updated_at])
}

/// One "Open when..." collection. The four starting collections are rows owned
/// by the client (`system_key` names them so copy can be translated and so they
/// cannot be duplicated by a retry); clients can add their own, which have a
/// null system_key and a name they chose.
model TreasureCollection {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  /// 'anxious' | 'low' | 'overwhelmed' | 'win' for the four seeded ones.
  system_key String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation("ClientToTreasureCollection", fields: [user_id], references: [id], onDelete: Cascade)
  notes      TreasureNote[]

  @@unique([user_id, system_key])
  @@index([user_id, sort_order])
}

/// A Treasure Box note: something worth keeping, written by the client or sent
/// by the therapist. `body` is client-visible text; every write is safety
/// checked the same way chat is (owner decision 3).
///
/// Privacy by construction mirrors WorksheetResponse: no therapist column. A
/// note reaches a therapist only through shared_with_therapist AND a live
/// TherapistClient link, and un-sharing clears it from view immediately.
model TreasureNote {
  id         String   @id @default(uuid())
  user_id    String
  title      String?
  body       String
  /// 'self' | 'therapist' | 'worksheet' | 'journal' | 'chat' — where it came
  /// from. `source_ref` points at the originating row (journal entry id,
  /// worksheet response id, chat turn id...) without a polymorphic FK, because
  /// those tables are allowed to be deleted while the kept note survives.
  source     String   @default("self")
  source_ref String?
  collection_id String?
  tags       String[] @default([])
  pinned     Boolean  @default(false)
  /// Per-item share (owner decision 6). Default false.
  shared_with_therapist Boolean @default(false)
  shared_at  DateTime?
  unshared_at DateTime?
  /// Recorded when the safety check fired on this note's text; no content.
  safety_flagged Boolean @default(false)
  safety_level String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation("ClientToTreasureNote", fields: [user_id], references: [id], onDelete: Cascade)
  collection TreasureCollection? @relation(fields: [collection_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, collection_id])
  @@index([user_id, shared_with_therapist])
  @@index([user_id, pinned])
}

enum SummaryStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED_TRIVIAL
}

enum HomeworkStatus {
  active
  completed
  archived
}

enum LanguageMode {
  english
  mirror
}

/// OKUVU v2.0: canonical tool-id registry (docs/okuvu-v2.0's B.3 — "chat
/// parity: T1-T8 column" replacement). The 5 clinically-approved exercises
/// (decisions doc round, 15 Sep 2026 §3) are seeded here — `text` is the
/// single canonical copy for that exercise, read verbatim by the mobile
/// player; apps/api/src/prompts/a2-okuvu-v2.0.txt is hand-aligned to match
/// it rather than reading it live (data parity, not live orchestrator
/// wiring — see §7). Now wired as the optional tool link on Reminder (§D
/// reminders workstream) and on Homework (§5).
model ToolRegistryEntry {
  id            String     @id @default(uuid())
  /// Natural key. Exercises keep their original ids (`grounding_5431`, ...).
  /// Worksheets are namespaced `ws_<slug>` so the two can never collide.
  tool_id       String     @unique
  label         String
  text          String
  chat_guidable Boolean    @default(true)
  /// 'exercise' | 'worksheet'. The Library is ONE catalogue: the approved
  /// exercises and the worksheets live in this table rather than in a second
  /// list, so "nothing duplicated" holds at the data layer, and an assignment
  /// (Homework.tool_id) points at either kind without a polymorphic join.
  kind          String     @default("exercise")
  /// --- Worksheet catalogue fields. Null for exercises. ---
  /// Short one-line description shown under the title (and its Hinglish
  /// twin). `label`/`text` stay the exercise copy columns; a worksheet stores
  /// its body in `content_en`/`content_hi` as structured JSON (intro, fields,
  /// closing) so the client renders approved wording rather than parsing prose.
  summary       String?
  summary_hi    String?
  label_hi      String?
  /// Library section key: notice_and_name | calm_my_body |
  /// untangle_thoughts | do_what_matters | people_boundaries | be_kinder |
  /// energy_life | before_after | safety.
  section       String?
  /// Which therapy it comes from (CBT, ACT, DBT, ...). Therapists only — never
  /// serialized to a client response. The API layer enforces that; this column
  /// is simply where it lives.
  therapy_modality String?
  /// The approved document's "For therapists:" line. Therapists only, and never
  /// serialized to a client: it is framing, not copy.
  therapist_note String?
  /// Which Library card a row hangs off, e.g. the four breathing techniques are
  /// `breathing`. NULL means the row is its own card.
  library_group String?
  /// Who can open it: 'open' (anyone), 'assigned' (only after the therapist
  /// assigns it), 'in_session' (filled in together during a session).
  access_mode   String     @default("open")
  /// 'light' | 'demanding'. Drives the high-load gate (intensity above 5/10).
  load_level    String?
  est_minutes   Int?
  /// Approved worksheet body, structured. Shape is owned by
  /// packages/shared-types (added in the copy step); stored as JSON so the
  /// approved wording is data, not code.
  content_en    Json?
  content_hi    Json?
  /// 'draft' | 'approved' | 'retired'. Default draft on purpose: a worksheet
  /// that is inserted without an explicit status must never reach a client.
  /// Client queries filter kind='worksheet' AND status='approved'.
  /// Exercises are 'approved'; `guided_breathing` is 'retired' (clinical review
  /// v2.0.0) so it disappears from the Library without deleting the row that
  /// old Homework/Reminder links still reference.
  status        String     @default("draft")
  approved_at   DateTime?
  sort_order    Int        @default(0)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  reminders     Reminder[]
  homeworks     Homework[]
  preferences   UserToolPreference[]
  worksheet_responses WorksheetResponse[] @relation("WorksheetToResponse")

  @@index([kind, status, section, sort_order])
}

/// OKUVU v2.0: a client's chosen pace preset for one approved exercise —
/// covers both their own default (box breathing, no Homework row needed)
/// and any therapist-assigned exercise (same tool_id as the Homework row).
/// Decisions doc round, 15 Sep 2026 §1/§4: "pace = client-only" — this
/// table is the client's write, never the therapist's; presets are always
/// slower/standard/faster, clamped to the safe band in application code
/// (apps/mobile's breathing_presets.dart), not stored as raw seconds here.
model UserToolPreference {
  id           String            @id @default(uuid())
  user_id      String
  tool_id      String
  pace_preset  String            @default("standard")
  updated_at   DateTime          @updatedAt
  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tool         ToolRegistryEntry @relation(fields: [tool_id], references: [tool_id])

  @@unique([user_id, tool_id])
}

/// OKUVU v2.0: canonical crisis-helpline source (master-handoff O7 —
/// "iCall+Vandrevala minimum, decide rest"). Now seeded with all 5 numbers
/// the mobile app's crisis_overlay.dart already ships (iCall, Vandrevala,
/// NIMHANS, Snehi, Emergency Services) — reconciled 12 Sep, migration
/// 20260912170000. A9-post's prompt was updated to match. The mobile app's
/// own rendering stays hardcoded/offline-safe on purpose; it is not wired
/// to read from this table (crisis support must work with no network).
model CrisisResource {
  id         String   @id @default(uuid())
  name       String
  phone      String
  order      Int      @default(0)
  created_at DateTime @default(now())
}


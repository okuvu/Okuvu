generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(uuid())
  /// Nullable: therapist-portal wireframes' Add-Client wizard creates a
  /// placeholder User row (email/phone from intake) BEFORE the client has
  /// ever opened the app — every prior User was mobile-signup-first, where
  /// this was always known immediately. Populated by POST /invites/redeem
  /// once the client completes Firebase phone-auth for the first time.
  /// Still unique — Postgres treats multiple NULLs as distinct, so this
  /// doesn't weaken the constraint for rows that do have one.
  firebase_uid        String?             @unique
  phone_number        String
  /// Therapist-portal wireframes C-01 — dual-channel OTP invite (phone +
  /// email both required at wizard step 1). Null for pre-wizard users.
  email               String?
  /// Therapist-portal wireframes C-01 — the therapist's own record of the
  /// client's legal name, for portal display only. Distinct from
  /// ClinicalConfig.display_abbreviation, which is what the client sees
  /// of themselves in the app.
  full_name           String?
  date_of_birth       DateTime?
  gender              String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// OKUVU v2.0: english (default) | mirror (adaptive Hinglish). Set via
  /// GET/PATCH /settings/language — apps/mobile's Settings > Language screen.
  language_mode       LanguageMode        @default(english)
  /// okuvu-remaining-changes.md O6: quote-of-day, opt-in. Content today is
  /// a small placeholder list per care plan (apps/api's quote-of-day.ts) —
  /// swap for a real source once one is decided; the toggle/plumbing is real.
  quote_of_day_enabled Boolean            @default(false)
  /// Settings > Notifications toggles. Inert booleans, same shape as
  /// quote_of_day_enabled/voice_mode_enabled — no push/FCM delivery exists
  /// yet (see okuvu-remaining-changes.md), this is preference-capture only.
  appointment_reminders_enabled Boolean   @default(true)
  chat_nudges_enabled Boolean             @default(true)
  clinical_config     ClinicalConfig?
  emergency_contact   EmergencyContact?
  engagement_profile  EngagementProfile?
  user_memory         UserMemory?
  mood_logs           MoodLog[]
  safety_state        SafetyState?
  session_logs        SessionLog[]
  session_summaries   SessionSummary[]
  assigned_therapists TherapistClient[]
  notes_received      TherapistNote[]     @relation("ClientToNote")
  turns               Turn[]
  journal_entries     JournalEntry[]
  access_logs         ClinicalAccessLog[] @relation("ClientToAccessLog")
  homeworks           Homework[]          @relation("ClientToHomework")
  reminders           Reminder[]
  appointments        Appointment[]       @relation("ClientToAppointment")
  invite_tokens       InviteToken[]
  tool_preferences    UserToolPreference[]
}

model Therapist {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  image              String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  client_assignments TherapistClient[]
  notes              TherapistNote[]     @relation("TherapistToNote")
  access_logs        ClinicalAccessLog[]
  homeworks_assigned Homework[]          @relation("TherapistToHomework")
  appointments       Appointment[]       @relation("TherapistToAppointment")
  invite_tokens      InviteToken[]
}

model ClinicalConfig {
  id                       String          @id @default(uuid())
  user_id                  String          @unique
  care_plan_id             CarePlan
  assignment_state         AssignmentState @default(provisional)
  created_at               DateTime        @default(now())
  confidence_at_last_eval  Float?
  turns_evaluated          Int             @default(0)
  reasoning_note           String?
  care_plan_review_flagged Boolean         @default(false)
  /// OKUVU v2.0: therapist-authored free text steering A2's
  /// ${care_plan_focus} — replaces gating A2's prompt on the bare CP1/2/3
  /// label. Null until the portal gets a write path for it (out of scope
  /// this pass); agent-context.ts falls back to a generic label derived
  /// from care_plan_id until then.
  care_plan_focus          String?
  /// Therapist-portal wireframes C-02 — step 2, "brief history," all
  /// optional. Never shown to the client.
  presenting_issues        String[]        @default([])
  /// Therapist-portal wireframes C-04 — step 4's welcome note, rendered on
  /// the mobile app's new onboarding welcome screen at first run.
  welcome_note             String?
  /// Therapist-portal wireframes C-04 — step 4's display abbreviation
  /// (e.g. "S." from "Shubhangi"), editable by the client at first run.
  display_abbreviation     String?
  user                     User            @relation(fields: [user_id], references: [id])
}

model SafetyState {
  id                               String           @id @default(uuid())
  user_id                          String           @unique
  safety_state_current             SafetyStateEnum
  safety_state_at_last_session_end SafetyStateEnum?
  updated_at                       DateTime         @updatedAt
  user                             User             @relation(fields: [user_id], references: [id])
}

model SessionLog {
  id                     String                      @id @default(uuid())
  user_id                String
  session_started_at     DateTime                    @default(now())
  session_ended_at       DateTime?
  turn_count             Int                         @default(0)
  session_feedback_score Int?
  crisis_flag_detected   Boolean                     @default(false)
  summary_embedding      Unsupported("vector(768)")?
  user                   User                        @relation(fields: [user_id], references: [id])
  summaries              SessionSummary[]
  turns                  Turn[]

  @@index([user_id, session_started_at(sort: Desc)])
}

model Turn {
  id             String     @id @default(uuid())
  session_id     String
  user_id        String
  turn_number    Int
  role           String
  content        String
  is_a9_fallback Boolean    @default(false)
  // Which model/prompt version actually produced `content` (assistant turns
  // only — user turns have no model involved). Null when no model call
  // completed for this turn, or when A9-post substituted a static
  // getSafeFallback() string over A2's output (see orchestrator.ts's
  // turnModelVersion/turnPromptVersion comments) — content that isn't
  // actually model-produced should not be attributed to one.
  model_version  String?
  prompt_version String?
  // OKUVU — Plumbing Fixes & Rationale v1.0, A4: which mechanism produced a
  // substitute reply (assistant turns only). Null on every turn whose content
  // is genuinely A2's model output; set whenever a static response replaced
  // or degraded the real one:
  //   'a2_degraded'      — A2 itself timed out / errored (A2_DEGRADED_RESPONSE)
  //   'a9_pre_blocked'   — A8 routed mode='blocked' (A9_PRE_BLOCKED_RESPONSE)
  //   'a9_post_blocked'  — A9-post BLOCKED and substituted getSafeFallback()
  //   'a9_post_unavailable' — A9-post call failed at S2 and fail-closed
  //   'deterministic_grounding' — A8 routed agent='deterministic-grounding'
  // Persisted alongside (not instead of) `fallback_used` — that flag must
  // now be true for every one of these paths (A4's "telemetry lies on
  // blocks" fix), so the scorecard's zero-tolerance fallback count is honest.
  fallback_source String?
  // A2's own S-07 signal (assistant turns only) — okuvu-remaining-changes.md
  // §B.2/§C.2: previously computed by the LLM every turn and discarded
  // entirely, no consumer read them. Persisted here so a future pass has
  // data to build on; no consumer logic (auto-close, report card, therapist
  // notifications) exists yet.
  taper_state         String  @default("none")
  closure_offered     Boolean @default(false)
  frustration_event   Boolean @default(false)
  homework_referenced Boolean @default(false)
  therapist_referral  Boolean @default(false)
  created_at     DateTime   @default(now())
  session        SessionLog @relation(fields: [session_id], references: [id])
  user           User       @relation(fields: [user_id], references: [id])

  @@unique([session_id, turn_number, role])
  @@index([session_id, turn_number])
  @@index([user_id, created_at(sort: Desc)])
}

model SessionSummary {
  id                String        @id @default(uuid())
  user_id           String
  session_id        String
  summary_text      String?
  last_updated_turn Int
  last_updated_at   DateTime      @updatedAt
  created_at        DateTime      @default(now())
  status            SummaryStatus @default(PENDING)
  session           SessionLog    @relation(fields: [session_id], references: [id])
  user              User          @relation(fields: [user_id], references: [id])

  @@unique([user_id, session_id])
  @@index([user_id, created_at(sort: Desc)])
}

model EngagementProfile {
  id                 String    @id @default(uuid())
  user_id            String    @unique
  current_streak     Int       @default(0)
  longest_streak     Int       @default(0)
  last_session_date  DateTime?
  voice_mode_enabled Boolean   @default(false)
  consent_1          Boolean   @default(false)
  consent_2          Boolean   @default(false)
  consent_3          Boolean   @default(false)
  consent_4          Boolean   @default(false)
  user               User      @relation(fields: [user_id], references: [id])
}

model UserMemory {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id])

  life_context       String[]
  recurring_themes   String[]
  what_helps         String[]
  what_doesnt_help   String[]
  significant_events String[]
  current_stressors  String[]
  /// OKUVU v2.0: assigned homework + the user's reported outcome, tagged by
  /// session (e.g. "grounding before bed — not_done, forgot [session 5]").
  homework_track     String[]
  emotional_baseline String?

  session_count Int @default(0)

  created_at   DateTime @default(now())
  last_updated DateTime @updatedAt

  @@index([user_id])
}

model TherapistNote {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  note_text      String
  created_at     DateTime  @default(now())
  client         User      @relation("ClientToNote", fields: [client_user_id], references: [id])
  therapist      Therapist @relation("TherapistToNote", fields: [therapist_id], references: [id])

  @@index([client_user_id, created_at(sort: Desc)])
}

model TherapistClient {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  created_at     DateTime  @default(now())
  /// OKUVU v2.0: client's consent for this therapist to view raw chat
  /// content (vs. summaries only). Defaults false (opt-in). Enforced on
  /// Report Card, Session Prep, and clients.detail's careReviewFlagged.
  /// Settable via admin.assignClient's Add-Client flow (an admin/therapist
  /// attestation that consent was obtained out-of-band — there is still no
  /// client-facing consent UI). Field name matches
  /// docs/okuvu-v2.0/01-parity-audit-v1.md's own proposal.
  chat_access_granted Boolean @default(false)
  /// Therapist-portal wireframes: set when the therapist clicks "Request
  /// chat access" (clients.requestChatAccess). Cleared by the client's own
  /// grant/deny via PATCH /users/me/chat-access. Null = never requested.
  chat_access_requested_at DateTime?
  /// Status lifecycle (wireframes C-07/C-08) is DERIVED, not stored, from
  /// created_at/activated_at/ended_at — see clients.ts's deriveStatus() —
  /// to avoid a redundant field that can drift from the timestamps.
  /// Set the first time this client pulls GET /users/me/today or
  /// /users/me/context after redeeming their invite (markClientActivatedIfNeeded).
  activated_at   DateTime?
  /// Set by clients.end — the therapist removing a client from their
  /// roster. Never deletes the row; keeps full history.
  ended_at       DateTime?
  client         User      @relation(fields: [client_user_id], references: [id])
  therapist      Therapist @relation(fields: [therapist_id], references: [id])

  @@unique([therapist_id, client_user_id])
  @@index([client_user_id])
}

/// OKUVU v2.0: therapist-assigned homework. Read by A2's ${homework}
/// (agent-context.ts pulls the most recent `active` row's description) and
/// (eventually) Worker 05's homework_progress. Assigned via the portal's
/// Homework page (apps/therapist-portal/.../clients/[id]/homework) — always
/// free-text `description`, optionally also linked to a specific approved
/// exercise via `tool_id` (decisions doc round, 15 Sep 2026 §5) so the
/// client app can render it as a real, playable exercise rather than just
/// prose.
model Homework {
  id             String              @id @default(uuid())
  client_user_id String
  therapist_id   String
  description    String
  tool_id        String?
  status         HomeworkStatus      @default(active)
  assigned_at    DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  client         User                @relation("ClientToHomework", fields: [client_user_id], references: [id])
  therapist      Therapist           @relation("TherapistToHomework", fields: [therapist_id], references: [id])
  tool           ToolRegistryEntry?  @relation(fields: [tool_id], references: [tool_id])
  reminders      Reminder[]

  @@index([client_user_id, status, assigned_at(sort: Desc)])
}

/// OKUVU v2.0: scheduler source for homework/tool-practice reminders.
/// `schedule_note` stays free text (therapist-authored) alongside the
/// structured `frequency`/`times` fields — those two are read by the
/// Today-card pull API; delivery (push/scheduler) is a separate,
/// out-of-scope-this-pass workstream. `frequency` is a plain string, not an
/// enum, to avoid the CREATE TYPE privilege friction hit earlier this
/// session: one of 'off' | 'once_daily' | 'twice_daily' | 'thrice_daily' |
/// 'as_needed'. `times` holds up to 3 "HH:mm" entries, meaningful only for
/// the *_daily frequencies.
model Reminder {
  id            String             @id @default(uuid())
  user_id       String
  homework_id   String?
  tool_id       String?
  frequency     String             @default("off")
  times         String[]           @default([])
  schedule_note String
  active        Boolean            @default(true)
  created_at    DateTime           @default(now())
  user          User               @relation(fields: [user_id], references: [id])
  homework      Homework?          @relation(fields: [homework_id], references: [id])
  tool          ToolRegistryEntry? @relation(fields: [tool_id], references: [tool_id])

  @@index([user_id, active])
}

// Records every therapist read of a client's clinical data (safety state,
// reasoning note, session summary, session notes) for breach/incident
// forensics. See docs/audit/evia-therapist-portal-audit.md F-05 — there was
// previously no way to answer "who viewed this client's record, and when."
model ClinicalAccessLog {
  id             String    @id @default(uuid())
  therapist_id   String
  client_user_id String
  action         String
  created_at     DateTime  @default(now())
  therapist      Therapist @relation(fields: [therapist_id], references: [id])
  client         User      @relation("ClientToAccessLog", fields: [client_user_id], references: [id])

  @@index([client_user_id, created_at(sort: Desc)])
  @@index([therapist_id, created_at(sort: Desc)])
}

/// Therapist-portal wireframes P-01..P-04. Distinct from SessionLog (a
/// chat conversation) — this is a calendar appointment between a
/// therapist and client. Repeat-weekly materializes N independent rows at
/// creation time, not a recurrence-rule field. Reschedule creates a NEW
/// row with rescheduled_from pointing back and sets the old row's
/// cancelled_at (superseded, never deleted). Not gated on
/// chat_access_granted — appointment logistics aren't raw chat content.
/// remind_24h/remind_1h are stored but not acted on yet (no push/SMS
/// infra exists anywhere — see okuvu-remaining-changes.md), matching the
/// wireframe's own "infra incomplete" annotation.
model Appointment {
  id               String    @id @default(uuid())
  therapist_id     String
  client_user_id   String
  scheduled_at     DateTime
  duration_minutes Int       @default(50)
  mode             String    // 'video' | 'phone' | 'in_person'
  location         String?
  note_to_client   String?
  remind_24h       Boolean   @default(false)
  remind_1h        Boolean   @default(false)
  rescheduled_from String?
  cancelled_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  therapist        Therapist @relation("TherapistToAppointment", fields: [therapist_id], references: [id])
  client           User      @relation("ClientToAppointment", fields: [client_user_id], references: [id])

  @@index([therapist_id, scheduled_at])
  @@index([client_user_id, scheduled_at])
}

/// Therapist-portal wireframes C-06 — the Add-Client wizard's provisioning
/// flow: therapist submits → placeholder User + ClinicalConfig +
/// TherapistClient(pending) + this token → Brevo email (+ manual
/// SMS/WhatsApp share of the same link) → client OTP-activates via
/// POST /invites/redeem, which populates User.firebase_uid and sets
/// redeemed_at.
/// token_hash, not the plaintext code — the invite code is randomly
/// generated (8 chars, 33-char alphabet), one-directionally hashed
/// (SHA-256) before it's ever written here, and only the plaintext is
/// emailed to the client. Redemption re-hashes the client-submitted code
/// and looks up by that hash, so the DB never holds anything that alone
/// lets a reader redeem an invite.
model InviteToken {
  id             String    @id @default(uuid())
  token_hash     String    @unique
  therapist_id   String
  client_user_id String
  created_at     DateTime  @default(now())
  expires_at     DateTime
  redeemed_at    DateTime?
  therapist      Therapist @relation(fields: [therapist_id], references: [id])
  client         User      @relation(fields: [client_user_id], references: [id])

  @@index([client_user_id])
}

model EmergencyContact {
  id              String   @id @default(uuid())
  user_id         String   @unique
  encrypted_name  String
  encrypted_phone String
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id])
}

// S6 (waitlist) — captured when a phone number with no invite/account hits
// /auth/verify-otp's NO_ACCOUNT path. Follow-up (sending an invite) is a
// manual therapist/ops action against this table, not automated.
model WaitlistEntry {
  id           String   @id @default(uuid())
  email        String
  phone_number String?
  created_at   DateTime @default(now())
}

model MoodLog {
  id         String   @id @default(uuid())
  user_id    String
  mood_value Int
  date_ist   DateTime @db.Date
  source     String   @default("user_input")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, date_ist])
  @@index([user_id, date_ist(sort: Desc)])
}

model GovernanceLog {
  id              String   @id @default(uuid())
  session_id      String
  turn_number     Int
  gate            String
  decision        String
  violation_type  String?
  confidence      String
  blocked_content String?
  created_at      DateTime @default(now())
}

enum CarePlan {
  CP1
  CP2
  CP3
}

enum AssignmentState {
  provisional
  confirmed
}

enum SafetyStateEnum {
  S0
  S1
  S2
  S3
  S4
}


model JournalEntry {
  id         String   @id @default(uuid())
  user_id    String
  emotion    String
  intensity  Int
  content    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
}

enum SummaryStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED_TRIVIAL
}

enum HomeworkStatus {
  active
  completed
  archived
}

enum LanguageMode {
  english
  mirror
}

/// OKUVU v2.0: canonical tool-id registry (docs/okuvu-v2.0's B.3 — "chat
/// parity: T1-T8 column" replacement). The 5 clinically-approved exercises
/// (decisions doc round, 15 Sep 2026 §3) are seeded here — `text` is the
/// single canonical copy for that exercise, read verbatim by the mobile
/// player; apps/api/src/prompts/a2-okuvu-v2.0.txt is hand-aligned to match
/// it rather than reading it live (data parity, not live orchestrator
/// wiring — see §7). Now wired as the optional tool link on Reminder (§D
/// reminders workstream) and on Homework (§5).
model ToolRegistryEntry {
  id            String     @id @default(uuid())
  tool_id       String     @unique
  label         String
  text          String
  chat_guidable Boolean    @default(true)
  created_at    DateTime   @default(now())
  reminders     Reminder[]
  homeworks     Homework[]
  preferences   UserToolPreference[]
}

/// OKUVU v2.0: a client's chosen pace preset for one approved exercise —
/// covers both their own default (box breathing, no Homework row needed)
/// and any therapist-assigned exercise (same tool_id as the Homework row).
/// Decisions doc round, 15 Sep 2026 §1/§4: "pace = client-only" — this
/// table is the client's write, never the therapist's; presets are always
/// slower/standard/faster, clamped to the safe band in application code
/// (apps/mobile's breathing_presets.dart), not stored as raw seconds here.
model UserToolPreference {
  id           String            @id @default(uuid())
  user_id      String
  tool_id      String
  pace_preset  String            @default("standard")
  updated_at   DateTime          @updatedAt
  user         User              @relation(fields: [user_id], references: [id])
  tool         ToolRegistryEntry @relation(fields: [tool_id], references: [tool_id])

  @@unique([user_id, tool_id])
}

/// OKUVU v2.0: canonical crisis-helpline source (master-handoff O7 —
/// "iCall+Vandrevala minimum, decide rest"). Now seeded with all 5 numbers
/// the mobile app's crisis_overlay.dart already ships (iCall, Vandrevala,
/// NIMHANS, Snehi, Emergency Services) — reconciled 12 Sep, migration
/// 20260912170000. A9-post's prompt was updated to match. The mobile app's
/// own rendering stays hardcoded/offline-safe on purpose; it is not wired
/// to read from this table (crisis support must work with no network).
model CrisisResource {
  id         String   @id @default(uuid())
  name       String
  phone      String
  order      Int      @default(0)
  created_at DateTime @default(now())
}

// ─── Test Harness (TH-S03) ────────────────────────────────────────

model ModelConfigPin {
  id              String          @id @default(uuid())
  environment     TestEnvironment
  model_version   String
  provider        String          @default("gemini")
  prompt_hash     String
  temperature     Float
  safety_settings String
  suite_version   String
  pinned_by       String
  created_at      DateTime        @default(now())

  @@index([environment, created_at(sort: Desc)])
}

model PromptRegistryEntry {
  id            String          @id @default(uuid())
  agent_id      String
  version       String
  content       String
  content_hash  String
  environment   TestEnvironment
  supersedes_id String?
  created_at    DateTime        @default(now())

  @@index([agent_id, environment, created_at(sort: Desc)])
}

model TestRun {
  id                       String          @id @default(uuid())
  environment              TestEnvironment
  altitude                 Int
  agent                    String?
  status                   TestRunStatus
  frozen_triple            Json
  results                  Json
  // Whether this run actually executed under canned-response mode (either
  // deliberately, per shouldUseCanned(environment), or because
  // USE_CANNED_LLM_RESPONSE was ambiently set in-process — see
  // canned-mode.ts's isCannedRunActive). Persisted so a non-sandbox run that
  // went canned is visibly flagged rather than only inferable indirectly
  // from fallbackUsed/status.
  canned                   Boolean         @default(false)
  // ─── Run identity header (B2, OKUVU — Plumbing Fixes & Rationale v1.0) ───
  // "A result is only valid for the exact (build, model, prompt) it was
  // produced with." Populated on every run-creating router; null where the
  // value genuinely can't be determined (see run-identity.ts).
  build_sha                String?
  corpus_version           String?
  run_mode                 String?
  activated_agents         String[]
  manually_selected_agents String[]
  dependency_graph         Json
  created_at               DateTime        @default(now())
  completed_at             DateTime?
  archived_at              DateTime?
  result_rows              TestResultRow[]

  @@index([environment, created_at(sort: Desc)])
}

model TestResultRow {
  id         String        @id @default(uuid())
  run_id     String
  agent_id   String
  input      Json
  output     Json
  latency_ms Int
  signals    Json
  mock_mode  Boolean       @default(false)
  status     TestRunStatus
  created_at DateTime      @default(now())
  run        TestRun       @relation(fields: [run_id], references: [id])

  @@index([run_id])
}

model CorpusCase {
  id                    String           @id @default(uuid())
  type                  CorpusCaseType
  version               Int              @default(1)
  input                 String
  expected_output       String?
  tags                  String[]
  supersedes_id         String?
  data_origin           CorpusDataOrigin @default(synthetic)
  // Case-factory lineage (mvp-v2-engineering-spec.md §7): null for a golden,
  // hand-authored seed case; set to the seed CorpusCase's id for a
  // factory-generated variation. Distinct from supersedes_id, which tracks
  // versions of the SAME case rather than derived variants of a seed.
  seed_id               String?
  // Set true by the case-factory whenever a mutation kind may have changed
  // what expected_output should be (every kind except plain rephrasing —
  // see case-factory.ts's LABEL_PRESERVING_KINDS). A generated case's
  // expected_output still carries the seed's best-guess value, but it must
  // not be trusted for grading/gating until a human confirms or edits it.
  adjudication_required Boolean          @default(false)
  // okuvu-remaining-changes.md §E.2 — optional per-case pipeline context,
  // mirroring apps/api's TestModeOptions inject* fields (orchestrator.ts):
  // runCase builds a testMode object from these so a case can exercise A2
  // under a specific language mode / homework / toolkit / therapist-name
  // context instead of always hitting the synthetic session's defaults.
  // Null/empty means "use the pipeline's normal default," same as omitting
  // the corresponding inject* field.
  language_mode         String?
  homework_context      String?
  toolkit               String[]         @default([])
  therapist_name        String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  @@index([type, created_at(sort: Desc)])
  @@index([seed_id])
}

model BlindedReviewItem {
  id            String         @id @default(uuid())
  run_id        String
  output        String
  rubric_scores Json
  rater_id      String?
  unblinded_at  DateTime?
  created_at    DateTime       @default(now())
  ratings       ReviewRating[]

  @@index([run_id])
}

model ReviewRating {
  id         String            @id @default(uuid())
  item_id    String
  rater_id   String
  scores     Json
  created_at DateTime          @default(now())
  item       BlindedReviewItem @relation(fields: [item_id], references: [id])

  @@unique([item_id, rater_id])
}

model TestBudget {
  id              String          @id @default(uuid())
  environment     TestEnvironment @unique
  monthly_cap_inr Float
  spent_inr       Float           @default(0)
  reset_month     String
}

model TestHarnessAccess {
  id           String      @id @default(uuid())
  email        String      @unique
  role         HarnessRole
  environments String[]
  created_at   DateTime    @default(now())
}

model GateSignOff {
  id          String          @id @default(uuid())
  gate        String
  run_id      String?
  environment TestEnvironment
  signed_by   String
  decision    GateDecision
  evidence    String?
  signed_at   DateTime        @default(now())

  @@index([gate, environment, signed_at(sort: Desc)])
}

// mvp-v2-engineering-spec.md §7 "Baseline archive": pins a batch of TestRun
// ids (e.g. a full corpus sweep) as a named, diffable reference point — most
// commonly the pre-cutover Gemini baseline, captured before a model/prompt
// swap, per §8's "every swap re-runs the full corpus + RCI review before
// serving." Append-only, same pattern as GateSignOff/ModelConfigPin: pinning
// again under the same label creates a new row rather than mutating the
// old one, so every past baseline pin remains available.
model BaselineArchive {
  id          String          @id @default(uuid())
  environment TestEnvironment
  label       String
  run_ids     String[]
  pinned_by   String
  pinned_at   DateTime        @default(now())

  @@index([environment, label, pinned_at(sort: Desc)])
}

model BetaConsent {
  id                 String    @id @default(uuid())
  corpus_case_id     String?
  user_ref           String
  scope              String
  consent_granted_at DateTime  @default(now())
  expires_at         DateTime?

  @@index([user_ref])
}

enum TestEnvironment {
  sandbox
  staging
  beta
}

enum TestRunStatus {
  running
  pass
  halt
  warning
  error
  /// OKUVU — Plumbing Fixes & Rationale v1.0, B1: a run where any pipeline
  /// stage failed or no-oped (e.g. the A13/A15 summary worker being
  /// unreachable). Such runs are EXCLUDED from scorecard aggregation, never
  /// scored clean — a green run that skipped a stage is a false pass (the
  /// H-1 failure class the framework exists to prevent).
  incomplete
}

enum CorpusCaseType {
  safety
  fidelity
  adversarial
  persona
}

enum CorpusDataOrigin {
  synthetic
  paraphrased
  real
}

enum HarnessRole {
  PI
  RATER
  ENGINEER
}

enum GateDecision {
  APPROVED
  REJECTED
}

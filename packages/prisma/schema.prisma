}

model TestRun {
  id                       String          @id @default(uuid())
  environment              TestEnvironment
  altitude                 Int
  agent                    String?
  status                   TestRunStatus
  frozen_triple            Json
  results                  Json
  // Whether this run actually executed under canned-response mode (either
  // deliberately, per shouldUseCanned(environment), or because
  // USE_CANNED_LLM_RESPONSE was ambiently set in-process — see
  // canned-mode.ts's isCannedRunActive). Persisted so a non-sandbox run that
  // went canned is visibly flagged rather than only inferable indirectly
  // from fallbackUsed/status.
  canned                   Boolean         @default(false)
  // ─── Run identity header (B2, OKUVU — Plumbing Fixes & Rationale v1.0) ───
  // "A result is only valid for the exact (build, model, prompt) it was
  // produced with." Populated on every run-creating router; null where the
  // value genuinely can't be determined (see run-identity.ts).
  build_sha                String?
  corpus_version           String?
  run_mode                 String?
  // ─── TH-S33/S34 telemetry (Simulated-Conversation Runner Spec v1.1) ───
  // Populated on runs created by the simulated-conversation runner; null on
  // every other run kind (the same nullable+backfill-free convention as the
  // B2 identity columns above).
  persona_id               String?
  persona_version          String?
  simulator_model          String?
  session_index            Int?
  turn_in_session          Int?
  gap_before_ms            Int?
  activated_agents         String[]
  manually_selected_agents String[]
  dependency_graph         Json
  created_at               DateTime        @default(now())
  completed_at             DateTime?
  archived_at              DateTime?
  result_rows              TestResultRow[]

  @@index([environment, created_at(sort: Desc)])
}

model TestResultRow {
  id         String        @id @default(uuid())
  run_id     String
  agent_id   String
  input      Json
  output     Json
  latency_ms Int
  signals    Json
  mock_mode  Boolean       @default(false)
  status     TestRunStatus
  created_at DateTime      @default(now())
  run        TestRun       @relation(fields: [run_id], references: [id])

  @@index([run_id])
}

/// A campaign (TH-S38, /campaign screen): one operator-created batch of
/// simulated conversations — N personas × the same plan — uploaded from a
/// persona sheet, run step by step against the in-process pipeline, and read
/// back as per-conversation PASS / FAIL / UNGRADED / INCOMPLETE verdicts.
///
/// The row exists so a result is attributable to the conditions that produced
/// it: the persona snapshot, the plan, the seed, the judge setting and the
/// ceiling are all frozen here at start. Every conversation is a
/// ConversationRun group pointing back at this row via `campaign_id`.
model Campaign {
  id                String          @id @default(uuid())
  label             String
  environment       TestEnvironment
  /// Where the conversations actually ran: 'in-process' (this harness's real
  /// pipeline) or 'live-websocket' (the deployed api.okuvu.in surface). Stored
  /// rather than inferred — the two are different measurements and a results
  /// table must never mix them.
  target            String          @default("in-process")
  /// Persona snapshot taken at start, so a later persona edit cannot rewrite
  /// history: [{ caseId, personaId, personaVersion, expectedBehavior }].
  personas          Json
  sessions          Int
  turns_min         Int
  turns_max         Int
  /// [gapBeforeMsForSession1, session2, ...] — gap[0] is 0 by convention.
  gap_plan_ms       Int[]
  scheduler_mode    String          @default("story-time")
  seed              Int
  /// 'english' is the only mode the in-process runner presents today; the
  /// column exists so a live-driver run records its own mode honestly.
  language_mode     String          @default("english")
  /// Whether the LLM judge ran over the final reply of each session. Off
  /// leaves every conversation UNGRADED — never a pass.
  judge_enabled     Boolean         @default(true)
  cost_ceiling_usd  Float
  cost_estimates_usd Float          @default(0)
  planned_turns     Int
  /// planned | running | complete | incomplete | halt (rollup over groups).
  status            String          @default("planned")
  created_by        String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  groups            ConversationRun[]

  @@index([environment, created_at(sort: Desc)])
}

/// TH-S37 (OKUVU — Simulated-Conversation Runner Spec v1.1): the grouping row
/// for one simulated-conversation run batch — N sessions × M turns of ONE
/// synthetic persona driven across a planned gap schedule. Append-only,
/// same convention as ModelConfigPin/BaselineArchive: status/next_step/cost
/// rollup fields are the ONLY mutable columns (the tick loop needs a durable
/// resume point), and every content column (sessions, run_ids, persona pin)
/// is written once at group creation and never edited.
model ConversationRun {
  id              String             @id @default(uuid())
  environment     TestEnvironment
  /// The persona this batch drives — a type='persona' CorpusCase id (TH-S32).
  persona_case_id String
  /// Denormalized pinning stamps (§6.4 contract): personaId/personaVersion
  /// come from the case's persona_meta; model/promptVersion from the frozen
  /// triple at creation. Stored flat so the run-group list needs no joins.
  persona_id      String
  persona_version String
  model           String?
  prompt_version  String?
  /// 'story-time' (default — gaps injected as gap_before_ms, no real waits)
  /// | 'wall-clock' (Cloud-Tasks-scheduled real waits, staging only).
  scheduler_mode  String             @default("story-time")
  /// Multi-session plan (§6.2): [gapBeforeMsForSession1, session2, ...] —
  /// gap[0] is conventionally 0 (first session starts immediately).
  gap_plan_ms     Int[]
  /// Turn-count range per session; the orchestrator draws each session's
  /// actual count deterministically from the run's seed within [min, max].
  turns_min       Int
  turns_max       Int
  /// Deterministic simulator seed (TH-S33: "deterministic under a fixed
  /// seed"). Same seed + same persona + same history ⇒ same plan.
  seed            Int
  /// Cost rails (TH-S37): ceiling in USD (not INR — the spec's contract is
  /// USD, unlike TestBudget's monthly INR cap) and the running estimate.
  cost_ceiling_usd Float
  cost_estimates_usd Float         @default(0)
  /// Only mutable fields: the tick loop's durable resume point. status is
  /// one of 'planned' | 'running' | 'complete' | 'incomplete' | 'halt'.
  status          String             @default("planned")
  /// Next step the advance-tick should process: null = nothing due (done
  /// or not started). Shape: { sessionIndex, turnNumber, dueAt? } (§6.4).
  next_step       Json?
  /// Per-session rollup, written after each session closes (§6.4 sessions[]):
  /// [{ index, sessionId, gapBeforeMs, turnsPlanned, turnsCompleted,
  ///    summaryWritten, memoryWritten, runIds: string[],
  ///    continuity: { C1..C5 } }]
  sessions        Json               @default("[]")
  /// Completed per-session TestRun ids (flattened across the whole group) —
  /// what BaselineArchive pinning and the bulk export resolve against.
  run_ids         String[]           @default([])
  /// Idempotency (TH-S35): the caller-supplied key. Unique — a duplicate
  /// POST with the same key returns the existing group instead of creating
  /// a second one.
  idempotency_key String             @unique
  /// Session-scoped LLM spend accumulator (USD), updated as turns complete.
  cost_so_far_usd Float              @default(0)
  canned          Boolean            @default(false)
  /// TH-S38: the /campaign batch this group belongs to. Null for groups
  /// created by the machine-triggered /api/run-batch path.
  campaign_id     String?
  /// TH-S38: why a group stopped early (cost ceiling, worker unreachable,
  /// pipeline error, hard-fail rule). Null for a group that finished clean.
  /// Persisted so the results table can say why, instead of only "incomplete".
  incomplete_reason String?
  /// Per-session judge verdicts, written once when the group reaches a
  /// terminal status: [{ sessionIndex, judged, passed, rationale }]. Empty
  /// when the campaign ran with the judge off (those conversations stay
  /// UNGRADED) or when the run never reached a gradeable state.
  judge_verdicts  Json               @default("[]")
  campaign        Campaign?          @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@index([environment, created_at(sort: Desc)])
  @@index([persona_case_id])
  @@index([status])
  @@index([campaign_id])
}

model CorpusCase {
  id                    String           @id @default(uuid())
  type                  CorpusCaseType
  version               Int              @default(1)
  input                 String
  expected_output       String?
  tags                  String[]
  supersedes_id         String?
  data_origin           CorpusDataOrigin @default(synthetic)
  // Case-factory lineage (mvp-v2-engineering-spec.md §7): null for a golden,
  // hand-authored seed case; set to the seed CorpusCase's id for a
  // factory-generated variation. Distinct from supersedes_id, which tracks
  // versions of the SAME case rather than derived variants of a seed.
  seed_id               String?
  // Set true by the case-factory whenever a mutation kind may have changed
  // what expected_output should be (every kind except plain rephrasing —
  // see case-factory.ts's LABEL_PRESERVING_KINDS). A generated case's
  // expected_output still carries the seed's best-guess value, but it must
  // not be trusted for grading/gating until a human confirms or edits it.
  adjudication_required Boolean          @default(false)
  // okuvu-remaining-changes.md §E.2 — optional per-case pipeline context,
  // mirroring apps/api's TestModeOptions inject* fields (orchestrator.ts):
  // runCase builds a testMode object from these so a case can exercise A2
  // under a specific language mode / homework / toolkit / therapist-name
  // context instead of always hitting the synthetic session's defaults.
  // Null/empty means "use the pipeline's normal default," same as omitting
  // the corresponding inject* field.
  language_mode         String?
  homework_context      String?
  toolkit               String[]         @default([])
  therapist_name        String?
  // ─── TH-S32 (Simulated-Conversation Runner Spec v1.1) — persona bank ───
  // A type='persona' CorpusCase may carry an ordered seed script — the
  // "sample chat / starter" the user-simulator continues from. Each entry:
  // { role: 'user', text: string, expected?: { safetyState?, a2Stance? } }.
  // Nullable Json: non-persona cases (and personas seeded before this
  // column) simply have null — no backfill needed.
  turns                 Json?
  // TH-S32: the persona library metadata block — { personaId,
  // personaVersion, demographics, profile, trajectory, goals[], secrets[],
  // openerStyle, sampleStarters[], expectedArc, targetBand, governance,
  // techniqueFamily, continuityCues{}, determinismRules[] }. Consumed by the
  // TH-S33 user-simulator as its character sheet; carried onto every run for
  // pinning (TH-S37). Nullable for the same reason as `turns`.
  persona_meta          Json?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  @@index([type, created_at(sort: Desc)])
  @@index([seed_id])
}

model BlindedReviewItem {
  id            String         @id @default(uuid())
  run_id        String
  output        String
  rubric_scores Json
  rater_id      String?
  unblinded_at  DateTime?
  created_at    DateTime       @default(now())
  ratings       ReviewRating[]

  @@index([run_id])
}

model ReviewRating {
  id         String            @id @default(uuid())
  item_id    String
  rater_id   String
  scores     Json
  created_at DateTime          @default(now())
  item       BlindedReviewItem @relation(fields: [item_id], references: [id])

  @@unique([item_id, rater_id])
}

model TestBudget {
  id              String          @id @default(uuid())
  environment     TestEnvironment @unique
  monthly_cap_inr Float
  spent_inr       Float           @default(0)
  reset_month     String
}

model TestHarnessAccess {
  id           String      @id @default(uuid())
  email        String      @unique
  role         HarnessRole
  environments String[]
  created_at   DateTime    @default(now())
}

model GateSignOff {
  id          String          @id @default(uuid())
  gate        String
  run_id      String?
  environment TestEnvironment
  signed_by   String
  decision    GateDecision
  evidence    String?
  signed_at   DateTime        @default(now())

  @@index([gate, environment, signed_at(sort: Desc)])
}

// mvp-v2-engineering-spec.md §7 "Baseline archive": pins a batch of TestRun
// ids (e.g. a full corpus sweep) as a named, diffable reference point — most
// commonly the pre-cutover Gemini baseline, captured before a model/prompt
// swap, per §8's "every swap re-runs the full corpus + RCI review before
// serving." Append-only, same pattern as GateSignOff/ModelConfigPin: pinning
// again under the same label creates a new row rather than mutating the
// old one, so every past baseline pin remains available.
model BaselineArchive {
  id          String          @id @default(uuid())
  environment TestEnvironment
  label       String
  run_ids     String[]
  pinned_by   String
  pinned_at   DateTime        @default(now())

  @@index([environment, label, pinned_at(sort: Desc)])
}

model BetaConsent {
  id                 String    @id @default(uuid())
  corpus_case_id     String?
  user_ref           String
  scope              String
  consent_granted_at DateTime  @default(now())
  expires_at         DateTime?

  @@index([user_ref])
}

enum TestEnvironment {
  sandbox
  staging
  beta
}

enum TestRunStatus {
  running
  pass
  halt
  warning
  error
  /// OKUVU — Plumbing Fixes & Rationale v1.0, B1: a run where any pipeline
  /// stage failed or no-oped (e.g. the A13/A15 summary worker being
  /// unreachable). Such runs are EXCLUDED from scorecard aggregation, never
  /// scored clean — a green run that skipped a stage is a false pass (the
  /// H-1 failure class the framework exists to prevent).
  incomplete
}

enum CorpusCaseType {
  safety
  fidelity
  adversarial
  persona
}

enum CorpusDataOrigin {
  synthetic
  paraphrased
  real
}

enum HarnessRole {
  PI
  RATER
  ENGINEER
}

enum GateDecision {
  APPROVED
  REJECTED
}

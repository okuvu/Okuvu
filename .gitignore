# ============================================================
# EVIA — .gitignore
# Covers: Flutter, Node/TypeScript, GCP credentials, env files, dev tooling
# ============================================================

# ----------------------------
# Developer tooling (local only — never committed)
# ----------------------------
.opencode/
.claude/
graphify-out/
AGENTS.md

# ----------------------------
# CRITICAL — NEVER COMMIT THESE
# ----------------------------

# Environment variables
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
*.env

# GCP service account credentials
*-service-account.json
*-keyfile.json
gcp-keyfile.json
firebase-admin-sdk.json
firebase-adminsdk-*.json
application_default_credentials.json
service-account.json
serviceaccount.json

# Firebase config (contains API keys) — never commit real client config
apps/**/google-services.json
apps/**/GoogleService-Info.plist

# ----------------------------
# Node / TypeScript
# ----------------------------

# pnpm lockfile is committed (pnpm-lock.yaml) — do not ignore
# npm lockfile should NOT exist — if you see package-lock.json, delete it
package-lock.json
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo
.npm/

# Next.js
apps/therapist-portal/.next/
apps/therapist-portal/out/

# ----------------------------
# Flutter / Dart
# ----------------------------
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/key.properties
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/flutter_export_environment.sh
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Pods/
apps/mobile/ios/Runner.xcworkspace/xcuserdata/

# Generated Dart files (Prisma generates these, they're in packages/prisma/)
*.g.dart
*.freezed.dart

# ----------------------------
# Prisma
# ----------------------------
# Keep schema.prisma and migrations committed
# Do NOT commit generated client
packages/prisma/node_modules/

# ----------------------------
# GCP / Cloud Build
# ----------------------------
.gcloudignore

# ----------------------------
# Testing
# ----------------------------
coverage/
.nyc_output/
*.lcov
apps/mobile/coverage/

# ----------------------------
# Load test results (scripts committed, results are not)
# ----------------------------
load-tests/results/
load-tests/*.html

# ----------------------------
# OS files
# ----------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----------------------------
# Editor / IDE
# ----------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.ipr
*.iws
.fleet/
*.swp
*.swo
*~

# ----------------------------
# Logs
# ----------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ----------------------------
# Misc
# ----------------------------
*.pem
*.key
*.cert
*.p12
.cache/
tmp/
temp/

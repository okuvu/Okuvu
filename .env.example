# ============================================================
# EVIA — .env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.
# For production secrets, use GCP Secret Manager — not this file.
# ============================================================


# ============================================================
# DATABASE
# ============================================================

# Local dev: your personal Neon branch connection string
# Get this from neon.tech after following docs/neon-setup.md
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Production / staging: Cloud SQL via proxy (injected by Cloud Run at deploy time)
# Do not set this locally — Cloud Run sets it automatically
# CLOUD_SQL_CONNECTION_NAME="evia-500215:asia-south1:evia-db"


# ============================================================
# FIREBASE (Authentication)
# ============================================================

# evia-500215 Firebase project ID
# Get from Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID="evia-500215"

# Local dev only: path to your Firebase Admin SDK service account JSON
# Download from Firebase Console → Project Settings → Service Accounts
# This file must NEVER be committed — it is in .gitignore
FIREBASE_ADMIN_SDK_PATH="./firebase-admin-sdk.json"

# Local dev bypass — allows API calls without a real Firebase token
# Set to "true" ONLY for local development
# Cloud Run deployment NEVER sets this — it must remain unset in all cloud environments
LOCAL_DEV_BYPASS_AUTH="false"


# ============================================================
# VERTEX AI / GEMINI
# ============================================================

# GCP project ID for Vertex AI
VERTEX_AI_PROJECT_ID="evia-500215"

# Vertex AI region — must be asia-south1 (Mumbai) for DPDP compliance
VERTEX_AI_LOCATION="asia-south1"

# Gemini models (do not change without a full LLM Change Impact Register review)
GEMINI_PRO_MODEL="gemini-2.5-flash"
GEMINI_FLASH_LITE_MODEL="gemini-2.5-flash"

# Local dev only: path to GCP service account JSON for Vertex AI access
# This file must NEVER be committed — it is in .gitignore
# In Cloud Run, credentials are injected via Workload Identity, not this file
VERTEX_AI_SA_KEY_PATH="./gcp-keyfile.json"


# ============================================================
# SARVAM TTS (Text-to-Speech)
# ============================================================

# Sarvam API key — get from Sarvam dashboard
# Production value stored in GCP Secret Manager
SARVAM_API_KEY=""

# Sarvam TTS model
SARVAM_TTS_MODEL="bulbul:v2"

# Default TTS language (en-IN for MVP)
SARVAM_DEFAULT_LANGUAGE="en-IN"


# ============================================================
# GCP CLOUD STORAGE
# ============================================================

# Buckets (asia-south1 — same region as compute and DB)
GCP_BUCKET_TTS="evia-tts-audio-dev"
GCP_BUCKET_ASSETS="evia-assets-dev"

# Signed URL expiry
GCP_TTS_URL_EXPIRY_SECONDS="300"       # 5 minutes
GCP_ASSETS_URL_EXPIRY_SECONDS="3600"   # 1 hour


# ============================================================
# GCP CLOUD KMS (Encryption)
# ============================================================

# Key ring for emergency contact encryption (AES-256-GCM)
# Production value stored in GCP Secret Manager
CLOUD_KMS_KEY_RING="evia-user-keys"
CLOUD_KMS_KEY_NAME="emergency-contact-key"
CLOUD_KMS_LOCATION="asia-south1"

# Local dev fallback: base64-encoded 32-byte AES-256-GCM encryption key
# In production, the key is read from GCP Secret Manager (secrets/emergency-contact-key)
# Generate with: openssl rand -base64 32
EMERGENCY_CONTACT_ENCRYPTION_KEY=""


# ============================================================
# GCP CLOUD TASKS (Memory pipeline queue)
# ============================================================

CLOUD_TASKS_PROJECT_ID="evia-500215"
CLOUD_TASKS_QUEUE="evia-summary-queue-beta"
CLOUD_TASKS_LOCATION="asia-south1"

# URL of the evia-worker endpoint that Cloud Tasks will call
# Local dev: point to your local worker instance if running
CLOUD_TASKS_WORKER_URL="https://evia-worker-xxxx-uc.a.run.app"

# Service account email that Cloud Tasks will use for OIDC auth
# when calling the worker's /tasks/summary endpoint
WORKER_SERVICE_ACCOUNT_EMAIL="evia-app@evia-500215.iam.gserviceaccount.com"


# ============================================================
# MEMORYSTORE REDIS (Session rate limiting)
# ============================================================

# Local dev: use a local Redis instance (redis://localhost:6379)
# Staging/prod: Memorystore instance (injected at deploy time)
REDIS_URL="redis://localhost:6379"

# Session limits (do not change without Senior Engineer approval — these protect unit economics)
# SD tier: 1 session per day, 10 turns per session
# TL tier: 2 sessions per day, 10 turns per session
SESSION_LIMIT_SD_DAILY="1"
SESSION_LIMIT_TL_DAILY="2"
SESSION_TURN_LIMIT="10"


# ============================================================
# SENDGRID (Transactional email)
# ============================================================

SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@evia.ai"
SENDGRID_FROM_NAME="Evia"


# ============================================================
# FIREBASE CLOUD MESSAGING (Push notifications)
# ============================================================

# FCM server key — get from Firebase Console
# Production value stored in GCP Secret Manager
FCM_SERVER_KEY=""


# ============================================================
# APP CONFIG
# ============================================================

NODE_ENV="development"
PORT="8080"
LOG_LEVEL="debug"

# JWT config (Firebase handles token issuance — these are for validation)
JWT_AUDIENCE="evia-api"
JWT_ISSUER="https://securetoken.google.com/evia-dev"

# Session config
SESSION_TIMEOUT_IDLE_MINUTES="10"    # Close session after 10 min inactivity
SESSION_TIMEOUT_MAX_MINUTES="60"     # Hard cap: session cannot exceed 60 minutes


# ============================================================
# THERAPIST PORTAL (Next.js + NextAuth)
# ============================================================

# NextAuth — required for the therapist portal
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Google OAuth for therapist login
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ============================================================
# EVIA WORKER (background job service)
# ============================================================

WORKER_PORT="3002"

# OIDC token verification for Cloud Tasks → worker authentication
# Cloud Tasks sends OIDC tokens — the worker must verify them
WORKER_SERVICE_ACCOUNT_EMAIL="evia-app@evia-500215.iam.gserviceaccount.com"


# ============================================================
# LOCAL DEV CONVENIENCES
# ============================================================

# Set to "true" to use a canned A2 response instead of real Gemini calls
# Useful for Flutter UI development and load testing
USE_CANNED_LLM_RESPONSE="false"
CANNED_LLM_RESPONSE="I hear you. That sounds really difficult. Would you like to tell me more about what's been going on?"

# Set to "true" to skip Sarvam TTS and return a placeholder audio URL
USE_CANNED_TTS="false"

# ============================================================
# LOAD TEST MODE (evia-beta only — NEVER in production)
# ============================================================

# Set to "true" to bypass Firebase auth for k6 load test connections.
# Connections must include the matching x-load-test-key header.
# LOAD_TEST_MODE=true
# LOAD_TEST_KEY=<openssl rand -hex 32>

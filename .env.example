# ============================================================
# OKUVU — .env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.
# Production secrets live in AWS Secrets Manager (see AWS_SECRETS_PREFIX
# below) — not in this file, and not in task-definition env vars.
#
# Every value here is an AWS value. The stack runs in ap-south-1 (Mumbai):
# Bedrock for models, Cognito for identity, SQS for the summary queue,
# Secrets Manager for keys, ECS Fargate for compute, RDS for Postgres,
# ElastiCache for Redis, S3 for objects, CloudWatch for logs/metrics.
# ============================================================


# ============================================================
# DATABASE
# ============================================================

# Production/staging: RDS Postgres. The full URL is injected from Secrets
# Manager by the ECS task definition (infrastructure/aws/evia-beta/secrets.tf),
# not set by hand here.
DATABASE_URL="postgresql://[user]:***@[rds-host]:5432/okuvu?sslmode=require"


# ============================================================
# AWS CORE
# ============================================================

# ap-south-1 is required for DPDP 2026 data residency — do not point a
# production environment at another region.
AWS_REGION="ap-south-1"

# Bedrock model id used for every LLM call (per-call `model` params win).
# Default: amazon.nova-pro-v1:0 — served in-region in ap-south-1 and supports
# Bedrock tool use (used for schema-constrained JSON output).
# Claude in ap-south-1 is only reachable through an APAC cross-region inference
# profile (apac.anthropic.…), which moves prompt data outside India — clear
# that with DPDP before using it for real user data.
BEDROCK_MODEL_ID="amazon.nova-pro-v1:0"

# Bedrock embedding model + width.
# Default: amazon.titan-embed-text-v2:0 at 768 dimensions, which matches
# SessionLog.summary_embedding vector(768). Cohere Embed is 1024-dim — using it
# requires migrating the column AND re-embedding every stored summary
# (apps/worker/src/scripts/backfill-embeddings.ts); the client refuses to return
# a vector whose width != BEDROCK_EMBEDDING_DIMENSIONS. Vectors from different
# embedding models are not comparable, so switching this on an existing database
# without re-embedding silently breaks similarity search.
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
BEDROCK_EMBEDDING_DIMENSIONS="768"

# SQS queue for summary jobs. Terraform injects this as SQS_SUMMARY_QUEUE_URL;
# both names are accepted, SQS_QUEUE_URL wins when both are set.
SQS_QUEUE_URL=""

# Optional prefix for AWS Secrets Manager ids, e.g. "evia-beta" makes the
# emergency-contact key resolve to evia-beta/emergency-contact-key.
AWS_SECRETS_PREFIX=""


# ============================================================
# IDENTITY — AMAZON COGNITO
# ============================================================
#
# Two user pools:
#   * clients (mobile app)   — phone_number sign-in, SMS OTP, created by
#                              infrastructure/aws/evia-beta/cognito.tf
#   * therapists (portal)    — email + password (+ TOTP MFA), NextAuth
#                              CognitoProvider
#
# The API verifies client tokens offline against the pool JWKS; it never calls
# Cognito per request. COGNITO_USER_POOL_ID + COGNITO_CLIENT_ID are the only
# vars the verifier needs — the issuer is derived from them.

COGNITO_REGION="ap-south-1"

COGNITO_USER_POOL_ID="ap-south-1_XXXXXXXXX"
COGNITO_CLIENT_ID=""

COGNITO_THERAPIST_POOL_ID="ap-south-1_YYYYYYYYY"
COGNITO_THERAPIST_CLIENT_ID=""
COGNITO_THERAPIST_CLIENT_SECRET=""
COGNITO_ISSUER="https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_YYYYYYYYY"

# Local dev bypass — allows API calls without a real Cognito token.
# Set to "true" ONLY for local development. Cloud ECS task definitions never
# set this, and the therapist portal's boot guard refuses to start with it in
# NODE_ENV=production.
LOCAL_DEV_BYPASS_AUTH="false"


# ============================================================
# LLM PROVIDER
# ============================================================

# Which backend the pipeline agents (A1, A2, A9-pre, A9-post) call.
#   "openrouter" (default) — external API, used for load tests and as the
#                            non-AWS control when comparing model behaviour
#   "bedrock"              — Amazon Bedrock, in-VPC, the production path
LLM_PROVIDER="openrouter"

# OpenRouter (https://openrouter.ai) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct"


# ============================================================
# SARVAM TTS (Text-to-Speech)
# ============================================================

# Sarvam API key — get from Sarvam dashboard
# Production value stored in AWS Secrets Manager (sarvam-api-key)
SARVAM_API_KEY=""

SARVAM_TTS_MODEL="bulbul:v2"
SARVAM_DEFAULT_LANGUAGE="en-IN"


# ============================================================
# S3 (audio + assets)
# ============================================================

S3_BUCKET_TTS="okuvu-tts-audio-dev"
S3_BUCKET_ASSETS="okuvu-assets-dev"

# Presigned URL expiry
S3_TTS_URL_EXPIRY_SECONDS="300"       # 5 minutes
S3_ASSETS_URL_EXPIRY_SECONDS="3600"   # 1 hour


# ============================================================
# KMS (Encryption)
# ============================================================

# KMS key used to envelope-encrypt the emergency-contact AES-256-GCM data key.
KMS_KEY_ID="alias/okuvu-emergency-contact"

# Local dev fallback: base64-encoded 32-byte AES-256-GCM key.
# In production the key is read from AWS Secrets Manager
# (emergency-contact-key). Generate with: openssl rand -base64 32
EMERGENCY_CONTACT_ENCRYPTION_KEY=""


# ============================================================
# REDIS (session rate limiting)
# ============================================================

# Local dev: a local Redis instance (redis://localhost:6379)
# Staging/prod: ElastiCache, injected by the ECS task definition. Use a
# rediss:// URL when in-transit encryption is enabled (ioredis handles TLS).
REDIS_URL="redis://localhost:6379"


# ============================================================
# TOKEN / COST BUDGETS (E17-S6 — apps/api/src/lib/token-budget.ts)
# ============================================================

# Hard ceiling on tokens (input + output, as Bedrock reports them) for ONE chat
# session, and on measured list-price USD cost per user per UTC day. Both are
# enforced before a turn reaches a model; exceeding either returns the budget
# notice (WebSocket) or 429 (POST /journal/prompt), never a 500.
# Omit them to use the defaults below — the code never requires these to be set.
# Counters live in Redis (per-session tokens, per-session cost, per-day cost);
# without REDIS_URL they degrade to per-process counters rather than failing.
SESSION_TOKEN_BUDGET="500000"
DAILY_COST_BUDGET_USD="0.75"


# ============================================================
# BREVO (Transactional email — Add-Client wizard invite emails)
# ============================================================

# Get from Brevo dashboard → SMTP & API → API Keys
# Without this set, apps/api/src/lib/email.ts logs instead of sending — safe
# no-op in dev, but the wizard's invite email won't actually deliver until a
# real key is provided.
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@okuvu.in"
BREVO_FROM_NAME="OKUVU"


# ============================================================
# APP CONFIG
# ============================================================

NODE_ENV="development"
PORT="8080"
LOG_LEVEL="debug"

# Session config
SESSION_TIMEOUT_IDLE_MINUTES="10"    # Close session after 10 min inactivity
SESSION_TIMEOUT_MAX_MINUTES="60"     # Hard cap: session cannot exceed 60 minutes


# ============================================================
# THERAPIST PORTAL (Next.js + NextAuth)
# ============================================================

# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Therapist sign-in is Cognito (email + password + TOTP MFA), federated through
# NextAuth's CognitoProvider. The COGNITO_THERAPIST_* vars above are what it
# reads; there are no OAuth client ids to create anywhere.


# ============================================================
# WORKER (background job service)
# ============================================================

WORKER_PORT="3002"

# Shared secret the API and worker use to authenticate internal task calls
# (HMAC bearer over the internal ALB). Production value lives in Secrets
# Manager as worker-internal-auth-secret.
WORKER_INTERNAL_AUTH_SECRET=""

# Local dev only: when NODE_ENV=development and this is set, the API calls the
# worker's /tasks/summary endpoint directly instead of enqueuing to SQS.
# WORKER_INTERNAL_URL="http://localhost:3002"


# ============================================================
# LOCAL DEV CONVENIENCES
# ============================================================

# Set to "true" to use a canned response instead of real model calls.
# Useful for Flutter UI development and load testing.
USE_CANNED_LLM_RESPONSE="false"
CANNED_LLM_RESPONSE="I hear you. That sounds really difficult. Would you like to tell me more about what's been going on?"

# Set to "true" to skip Sarvam TTS and return a placeholder audio URL
USE_CANNED_TTS="false"

# ============================================================
# LOAD TEST MODE (evia-beta only — NEVER in production)
# ============================================================

# Set to "true" to bypass token verification for k6 load test connections.
# Connections must include the matching x-load-test-key header.
# LOAD_TEST_MODE=true
# LOAD_TEST_KEY=<openssl rand -hex 32>

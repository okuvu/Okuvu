# ============================================================
# EVIA — .env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.
# For production secrets, use GCP Secret Manager (or AWS Secrets Manager when
# OKUVU_SECRETS_PROVIDER=aws) — not this file.
# ============================================================


# ============================================================
# DATABASE
# ============================================================

# Local dev: your personal Neon branch connection string
# Get this from neon.tech after following docs/neon-setup.md
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Production / staging: Cloud SQL via proxy (injected by Cloud Run at deploy time)
# Do not set this locally — Cloud Run sets it automatically
# CLOUD_SQL_CONNECTION_NAME="evia-500215:asia-south1:evia-db"


# ============================================================
# FIREBASE (Authentication)
# ============================================================

# evia-500215 Firebase project ID
# Get from Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID="evia-500215"

# Local dev only: path to your Firebase Admin SDK service account JSON
# Download from Firebase Console → Project Settings → Service Accounts
# This file must NEVER be committed — it is in .gitignore
FIREBASE_ADMIN_SDK_PATH="./firebase-admin-sdk.json"

# Local dev bypass — allows API calls without a real Firebase token
# Set to "true" ONLY for local development
# Cloud Run deployment NEVER sets this — it must remain unset in all cloud environments
LOCAL_DEV_BYPASS_AUTH="false"


# ============================================================
# LLM PROVIDER
# ============================================================

# Which provider the pipeline agents (A1, A2, A9-pre, A9-post) call —
# "openrouter" (default) or "gemini" for rollback/baseline comparison
LLM_PROVIDER="openrouter"

# OpenRouter (https://openrouter.ai) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct"

# ============================================================
# VERTEX AI / GEMINI
# ============================================================

# GCP project ID for Vertex AI
VERTEX_AI_PROJECT_ID="evia-500215"

# Vertex AI region — must be asia-south1 (Mumbai) for DPDP compliance
VERTEX_AI_LOCATION="asia-south1"

# Gemini models (do not change without a full LLM Change Impact Register review)
GEMINI_PRO_MODEL="gemini-2.5-flash"
GEMINI_FLASH_LITE_MODEL="gemini-2.5-flash"

# Local dev only: path to GCP service account JSON for Vertex AI access
# This file must NEVER be committed — it is in .gitignore
# In Cloud Run, credentials are injected via Workload Identity, not this file
VERTEX_AI_SA_KEY_PATH="./gcp-keyfile.json"


# ============================================================
# AWS PROVIDERS (opt-in — every default below is the existing GCP behaviour)
# ============================================================
#
# The three OKUVU_*_PROVIDER vars are the ONLY switches that move a service
# off GCP. Leave them unset (or empty) in GCP environments: unset = the
# pre-migration code path, byte for byte. Values are matched
# case-insensitively; a value that is not one of the listed options is a hard
# error at call time (booting is unaffected) rather than a silent fallback to
# GCP — a typo must never send clinical text to a provider you think you
# turned off. Resolution lives in apps/api/src/lib/provider-config.ts and
# apps/worker/src/lib/provider-config.ts.
#
# | seam                 | env var                | values              | default    |
# |----------------------|------------------------|---------------------|------------|
# | LLM + embeddings     | OKUVU_LLM_PROVIDER     | vertex | bedrock    | vertex     |
# | summary queue        | OKUVU_QUEUE_PROVIDER   | cloudtasks | sqs    | cloudtasks |
# | secrets              | OKUVU_SECRETS_PROVIDER | gcp | aws           | gcp        |
#
# OKUVU_LLM_PROVIDER=bedrock takes precedence over LLM_PROVIDER (the older
# openrouter | gemini switch above, which is unchanged).

OKUVU_LLM_PROVIDER=""
OKUVU_QUEUE_PROVIDER=""
OKUVU_SECRETS_PROVIDER=""

# AWS region for Bedrock, SQS and Secrets Manager.
# Middleware/ECS injects AWS_REGION; unset defaults to ap-south-1 (Mumbai).
# ap-south-1 is required for DPDP 2026 data residency — do not point a
# production environment at another region.
AWS_REGION="ap-south-1"

# Bedrock model id used for every LLM call (per-call `model` params win).
# Default: amazon.nova-pro-v1:0 — served in-region in ap-south-1 and supports
# Bedrock tool use (used for schema-constrained JSON output).
# Claude in ap-south-1 is only reachable through an APAC cross-region
# inference profile (apac.anthropic.…), which moves prompt data outside
# India — clear that with DPDP before using it for real user data.
BEDROCK_MODEL_ID="amazon.nova-pro-v1:0"

# Bedrock embedding model + width.
# Default: amazon.titan-embed-text-v2:0 at 768 dimensions, which matches
# SessionLog.summary_embedding vector(768). Cohere Embed is 1024-dim — using
# it requires migrating the column AND re-embedding every stored summary
# (apps/worker/src/scripts/backfill-embeddings.ts); the client refuses to
# return a vector whose width != BEDROCK_EMBEDDING_DIMENSIONS.
# Vectors from different embedding models are not comparable, so switching
# this on an existing database without re-embedding silently breaks
# similarity search.
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
BEDROCK_EMBEDDING_DIMENSIONS="768"

# SQS queue for summary jobs (used only when OKUVU_QUEUE_PROVIDER=sqs).
# Terraform injects this as SQS_SUMMARY_QUEUE_URL; both names are accepted,
# SQS_QUEUE_URL wins when both are set.
SQS_QUEUE_URL=""

# Optional prefix for AWS Secrets Manager ids, e.g. "evia-beta" makes the
# emergency-contact key resolve to evia-beta/emergency-contact-key.
# Empty = bare name (identical to the GCP secret name, so the same key value
# can live under the same logical name in both clouds during cutover).
AWS_SECRETS_PREFIX=""


# ============================================================
# SARVAM TTS (Text-to-Speech)
# ============================================================

# Sarvam API key — get from Sarvam dashboard
# Production value stored in GCP Secret Manager
SARVAM_API_KEY=""

# Sarvam TTS model
SARVAM_TTS_MODEL="bulbul:v2"

# Default TTS language (en-IN for MVP)
SARVAM_DEFAULT_LANGUAGE="en-IN"


# ============================================================
# GCP CLOUD STORAGE
# ============================================================

# Buckets (asia-south1 — same region as compute and DB)
GCP_BUCKET_TTS="evia-tts-audio-dev"
GCP_BUCKET_ASSETS="evia-assets-dev"

# Signed URL expiry
GCP_TTS_URL_EXPIRY_SECONDS="300"       # 5 minutes
GCP_ASSETS_URL_EXPIRY_SECONDS="3600"   # 1 hour


# ============================================================
# GCP CLOUD KMS (Encryption)
# ============================================================

# Key ring for emergency contact encryption (AES-256-GCM)
# Production value stored in GCP Secret Manager
CLOUD_KMS_KEY_RING="evia-user-keys"
CLOUD_KMS_KEY_NAME="emergency-contact-key"
CLOUD_KMS_LOCATION="asia-south1"

# Local dev fallback: base64-encoded 32-byte AES-256-GCM encryption key
# In production, the key is read from GCP Secret Manager (secrets/emergency-contact-key)
# Generate with: openssl rand -base64 32
EMERGENCY_CONTACT_ENCRYPTION_KEY=""


# ============================================================
# GCP CLOUD TASKS (Memory pipeline queue)
# ============================================================
# Used only when OKUVU_QUEUE_PROVIDER is unset (default) or "cloudtasks".
# AWS equivalent: SQS — see SQS_QUEUE_URL in the AWS PROVIDERS section above.

CLOUD_TASKS_PROJECT_ID="evia-500215"
CLOUD_TASKS_QUEUE="evia-summary-queue-beta"
CLOUD_TASKS_LOCATION="asia-south1"

# URL of the evia-worker endpoint that Cloud Tasks will call
# Local dev: point to your local worker instance if running
CLOUD_TASKS_WORKER_URL="https://evia-worker-xxxx-uc.a.run.app"

# Service account email that Cloud Tasks will use for OIDC auth
# when calling the worker's /tasks/summary endpoint
WORKER_SERVICE_ACCOUNT_EMAIL="evia-app@evia-500215.iam.gserviceaccount.com"


# ============================================================
# MEMORYSTORE REDIS (Session rate limiting)
# ============================================================
# Wire-compatible with AWS ElastiCache — same var, no code change. Use a
# rediss:// URL when in-transit encryption is enabled (ioredis handles TLS).

# Local dev: use a local Redis instance (redis://localhost:6379)
# Staging/prod: Memorystore instance (injected at deploy time)
REDIS_URL="redis://localhost:6379"

# ============================================================
# SENDGRID (Transactional email) — unused placeholder, not wired up
# ============================================================

SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@okuvu.in"
SENDGRID_FROM_NAME="Okuvu"

# ============================================================
# BREVO (Transactional email — Add-Client wizard invite emails)
# ============================================================

# Get from Brevo dashboard → SMTP & API → API Keys
# Without this set, apps/api/src/lib/email.ts logs instead of sending —
# safe no-op in dev, but the wizard's invite email won't actually deliver
# until a real key is provided.
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@okuvu.in"
BREVO_FROM_NAME="OKUVU"


# ============================================================
# FIREBASE CLOUD MESSAGING (Push notifications)
# ============================================================

# FCM server key — get from Firebase Console
# Production value stored in GCP Secret Manager
FCM_SERVER_KEY=""


# ============================================================
# APP CONFIG
# ============================================================

NODE_ENV="development"
PORT="8080"
LOG_LEVEL="debug"

# JWT config (Firebase handles token issuance — these are for validation)
JWT_AUDIENCE="okuvu-api"
JWT_ISSUER="https://securetoken.google.com/evia-500215"

# Session config
SESSION_TIMEOUT_IDLE_MINUTES="10"    # Close session after 10 min inactivity
SESSION_TIMEOUT_MAX_MINUTES="60"     # Hard cap: session cannot exceed 60 minutes


# ============================================================
# THERAPIST PORTAL (Next.js + NextAuth)
# ============================================================

# NextAuth — required for the therapist portal
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Google OAuth for therapist login
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ============================================================
# EVIA WORKER (background job service)
# ============================================================

WORKER_PORT="3002"

# OIDC token verification for Cloud Tasks → worker authentication
# Cloud Tasks sends OIDC tokens — the worker must verify them
WORKER_SERVICE_ACCOUNT_EMAIL="evia-app@evia-500215.iam.gserviceaccount.com"


# ============================================================
# LOCAL DEV CONVENIENCES
# ============================================================

# Set to "true" to use a canned A2 response instead of real Gemini calls
# Useful for Flutter UI development and load testing
USE_CANNED_LLM_RESPONSE="false"
CANNED_LLM_RESPONSE="I hear you. That sounds really difficult. Would you like to tell me more about what's been going on?"

# Set to "true" to skip Sarvam TTS and return a placeholder audio URL
USE_CANNED_TTS="false"

# ============================================================
# LOAD TEST MODE (evia-beta only — NEVER in production)
# ============================================================

# Set to "true" to bypass Firebase auth for k6 load test connections.
# Connections must include the matching x-load-test-key header.
# LOAD_TEST_MODE=true
# LOAD_TEST_KEY=<openssl rand -hex 32>

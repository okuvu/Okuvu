{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M2.7",
  "permission": {
    "external_directory": "allow"
  },
  "mcp": {
    "clickup": {
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CLICKUP_API_KEY}"
      }
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    ".github/PULL_REQUEST_TEMPLATE.md"
  ]
}

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth for therapist login
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Firebase (phone auth — client-side config)
# Get these from Firebase Console → Project Settings → General → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="evia-500215.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="evia-500215"
NEXT_PUBLIC_FIREBASE_USE_EMULATOR="false"

# Firebase Admin SDK (server-side token verification)
# Required for production. For local dev with the auth emulator, leave these
# blank and set FIREBASE_AUTH_EMULATOR_HOST instead.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Auth emulator host (used by firebase-admin when set)
# Example: "localhost:9099" (matches firebase.json → emulators.auth.port)
FIREBASE_AUTH_EMULATOR_HOST=""

# Database (shared with evia-api)
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Admin allowlist (comma-separated emails) — gates /admin, the in-product
# therapist onboarding / client-assignment flow. Leave blank to disable it
# entirely (see docs/audit/evia-therapist-portal-audit.md F-07).
ADMIN_EMAILS=""

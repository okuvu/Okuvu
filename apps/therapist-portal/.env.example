# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in — therapist portal (beta launch).
# Therapists are onboarded by an admin using their personal address, so Google
# is the identity most of them already have. Optional and strictly additive:
# with no client id/secret the button is not rendered and Cognito (or nothing)
# is used exactly as before.
#
# Create at: Google Cloud Console → APIs & Services → Credentials →
# "Create credentials" → OAuth client ID → Web application.
# Authorised redirect URI (exact match, one per environment):
#   https://www.okuvu.in/api/auth/callback/google
#   https://okuvu.in/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# This is a GCP resource — docs/AWS-CUTOVER-SPEC.md removed Google once to drop
# the GCP dependency; the beta reinstates it knowingly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Amazon Cognito — therapist sign-in (see docs/AWS-CUTOVER-SPEC.md).
# The therapist user pool is separate from the mobile pool. The app client must
# have the authorization-code grant, a client secret, and the openid/profile/
# email scopes; MFA is enforced by the pool, not by this app.
AWS_REGION="ap-south-1"
COGNITO_REGION="ap-south-1"
COGNITO_THERAPIST_POOL_ID="ap-south-1_XXXXXXXX"
COGNITO_THERAPIST_CLIENT_ID=""
COGNITO_THERAPIST_CLIENT_SECRET=""
# https://cognito-idp.<region>.amazonaws.com/<COGNITO_THERAPIST_POOL_ID>
COGNITO_ISSUER=""

# Database (shared with evia-api)
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Admin allowlist (comma-separated emails) — gates /admin, the in-product
# therapist onboarding / client-assignment flow. An address here is also
# admitted to sign-in WITHOUT a Therapist row (admin@okuvu.in is an operator,
# not a clinician) and is redirected to /admin instead of /dashboard.
# Leave blank to disable it entirely
# (see docs/audit/evia-therapist-portal-audit.md F-07).
# Beta: ADMIN_EMAILS="admin@okuvu.in"
ADMIN_EMAILS=""

# Brevo (transactional email) — Add-Client wizard invite emails.
# Get from Brevo dashboard → SMTP & API → API Keys. Same account/key as
# apps/api's BREVO_API_KEY, configured separately here since the portal
# and API are independently-deployed services. Without this set, the
# invite code is still shown on-screen for manual share — just not emailed.
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@okuvu.in"
BREVO_FROM_NAME="OKUVU"

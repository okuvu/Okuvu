# TEMPLATE ONLY — copy to apps/mobile/android/keystore.properties and fill in locally.
#
# keystore.properties is gitignored and must NEVER be committed: it contains the upload
# key password. The keystore file itself must never be committed either (*.p12, *.jks and
# keystore.properties are all ignored — see .gitignore).
#
# The real values live in AWS Secrets Manager (ap-south-1):
#   aws secretsmanager get-secret-value \
#     --secret-id evia-beta/android-upload-keystore \
#     --query SecretString --output text
#
# The upload key is stored OUTSIDE the repository (E18-S1):
#   /opt/data/okuvu/keys/okuvu-upload.p12   (mode 600, RSA-4096, PKCS12, alias "upload")
#   CN=Okuvu, OU=Mobile, O=Okuvu Technologies, L=Mumbai, ST=Maharashtra, C=IN
#
# storeFile may be absolute (recommended) or relative to apps/mobile/android/.
# Create the filled-in file with mode 600:  chmod 600 keystore.properties
#
# With no keystore.properties present, release builds fall back to the debug key and
# release *bundles* fail fast — see android/app/build.gradle.

storePassword=REPLACE_WITH_STORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/okuvu-upload.p12
storeType=PKCS12

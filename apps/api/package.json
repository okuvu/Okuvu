{
  "name": "@okuvu/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/prompts/*.txt dist/prompts/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "k6 run load-tests/k6-websocket-load.js"
  },
  "dependencies": {
    "@okuvu/prisma": "workspace:*",
    "@okuvu/shared-types": "workspace:*",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.0.0",
    "@google-cloud/aiplatform": "^6.8.1",
    "@google-cloud/secret-manager": "^6.0.1",
    "@google-cloud/tasks": "^6.2.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}

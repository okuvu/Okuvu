{
  "name": "@okuvu/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/prompts/*.txt dist/prompts/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "k6 run load-tests/k6-websocket-load.js",
    "eval:gate": "tsx eval/run-gate.ts",
    "eval:v2": "tsx eval/v2/run-eval-v2.ts",
    "typecheck:eval": "tsc -p tsconfig.eval.json",
    "eval:approved-copy": "tsx eval/check-approved-copy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.0.0",
    "@okuvu/prisma": "workspace:*",
    "@okuvu/shared-types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}

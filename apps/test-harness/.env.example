# ============================================================
# EVIA Test Harness — .env.example
# ============================================================

# Test harness environment (sandbox, staging, beta)
TEST_HARNESS_ENV="sandbox"

# Database — same Neon branch as therapist-portal
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Google OAuth — required for NextAuth
GOOGLE_CLIENT_ID="971397352159-5gjlgjrarqqq633v6niftf773etj41f1.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# Per-environment API endpoints (target backend for each selectable environment)
TEST_HARNESS_API_SANDBOX="https://sandbox.api.evia.internal"
TEST_HARNESS_API_STAGING="https://staging.api.evia.internal"
TEST_HARNESS_API_BETA="https://beta.api.evia.internal"

# apps/worker base URL — used by the singleAgent router to invoke the
# combined A13 (summary) + A15 (memory) task via POST /tasks/summary.
# That route is OIDC-protected; without valid credentials the call will
# fail gracefully and the harness will surface an error result instead of
# crashing.
WORKER_URL="https://worker.evia.internal"

# TH-S17 — optional live Vertex AI pricing endpoint. If unset, the harness
# falls back to the static placeholder price table in src/lib/pricing.ts.
# No real Vertex AI pricing API contract is documented yet, so this is a
# best-effort integration point.
VERTEX_AI_PRICE_API_URL=""

# TH-S31 — beta environment data retention window (days). Read by the
# /beta capture-verification page and by apps/worker's
# POST /cleanup/beta-retention job. Default 90, per ADR-013.
BETA_RETENTION_DAYS="90"

# TH-S27 — GitHub Actions REST API credentials for the `ci` router
# (getGateStatus/triggerRegression/getHaltFailures) and the /ci page.
# GITHUB_TOKEN needs `actions:read`/`actions:write` (a fine-grained PAT
# scoped to this repo, or a GitHub App installation token) to list workflow
# runs and trigger workflow_dispatch on .github/workflows/regression.yml.
# GITHUB_REPO is "owner/repo" form, e.g. "evia-org/evia".
# NEVER commit a real token — leave these blank/placeholder in this file.
GITHUB_TOKEN=""
GITHUB_REPO=""

# Audit-bot API bypass (server/trpc.ts). Unset by default — the API
# requires real Google OAuth. When set, a request carrying a matching
# `x-audit-token` header authenticates as a PI-role session with no login.
# Rotate/unset this the moment the audit is done — never leave it set
# indefinitely, and never commit a real value here.
AUDIT_BYPASS_TOKEN=""

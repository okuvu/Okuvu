# ============================================================
# OKUVU Test Harness — .env.example
# ============================================================

# Test harness environment (sandbox, staging, beta)
TEST_HARNESS_ENV="sandbox"

# Database — same Neon branch as therapist-portal
DATABASE_URL="postgresql://[user]:[password]@[host]/evia?sslmode=require"

# Cognito therapist pool — required for NextAuth sign-in. Leave the client
# id/secret blank to run with HARD_HARNESS_LOCAL_DEV_BYPASS_AUTH (below).
COGNITO_REGION="ap-south-1"
COGNITO_THERAPIST_POOL_ID=""
COGNITO_THERAPIST_CLIENT_ID=""
COGNITO_THERAPIST_CLIENT_SECRET=""
# Optional explicit issuer; derived from region + pool id when blank.
# COGNITO_ISSUER="https://cognito-idp.ap-south-1.amazonaws.com/<pool-id>"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# Per-environment API endpoints (target backend for each selectable environment)
TEST_HARNESS_API_SANDBOX="https://sandbox.api.evia.internal"
TEST_HARNESS_API_STAGING="https://staging.api.evia.internal"
TEST_HARNESS_API_BETA="https://beta.api.evia.internal"

# apps/worker base URL — used by the singleAgent router to invoke the
# combined A13 (summary) + A15 (memory) task via POST /tasks/summary.
# The worker runs in the private subnets with no public ingress; without a
# reachable URL the call fails gracefully and the harness surfaces an error
# result instead of crashing.
WORKER_URL="https://worker.evia.internal"

# TH-S17 — optional live Bedrock pricing endpoint. If unset, the harness
# falls back to the static price table in src/lib/pricing.ts (which is
# derived from the AWS Price List API offer file for Bedrock in ap-south-1).
# No per-model pricing API contract is documented yet, so this is a
# best-effort integration point.
BEDROCK_PRICE_API_URL=""

# ============================================================
# LLM PROVIDER (apps/api/src/lib/generate-content.ts dispatcher)
# ============================================================
# Every agent invocation the harness makes (A1/A2/A9-pre/A9-post, plus
# judge.ts and case-factory.ts's LLM calls) goes through apps/api's real
# generate-content.ts dispatcher — these vars control which provider it
# resolves to for THIS app's process, independent of apps/api's own runtime
# env (see docs/test-harness/running-locally.md's "What won't work without
# additional setup" section).

# "bedrock" (default in production) or "openrouter" for baseline comparison
LLM_PROVIDER="bedrock"

# Required for any real (non-canned) call while LLM_PROVIDER=openrouter —
# without it, generateContent throws and every caller degrades to its
# documented fallback (same as any other model-call failure)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct"

# Bedrock (the default path). AWS credentials come from the ambient chain
# (aws configure / SSO profile / task role), not from this file.
AWS_REGION="ap-south-1"
BEDROCK_MODEL_ID="amazon.nova-pro-v1:0"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# TH-S31 — beta environment data retention window (days). Read by the
# /beta capture-verification page and by apps/worker's
# POST /cleanup/beta-retention job. Default 90, per ADR-013.
BETA_RETENTION_DAYS="90"

# TH-S27 — GitHub Actions REST API credentials for the `ci` router
# (getGateStatus/triggerRegression/getHaltFailures) and the /ci page.
# GITHUB_TOKEN needs `actions:read`/`actions:write` (a fine-grained PAT
# scoped to this repo, or a GitHub App installation token) to list workflow
# runs and trigger workflow_dispatch on .github/workflows/regression.yml.
# GITHUB_REPO is "owner/repo" form, e.g. "evia-org/evia".
# NEVER commit a real token — leave these blank/placeholder in this file.
GITHUB_TOKEN=""
GITHUB_REPO=""

# Audit-bot API bypass (server/trpc.ts). Unset by default — the API
# requires a real Cognito token. When set, a request carrying a matching
# `x-audit-token` header authenticates as a PI-role session with no login.
# Rotate/unset this the moment the audit is done — never leave it set
# indefinitely, and never commit a real value here.
# Local-dev bypass for Cognito sign-in — synthetic PI session, sandbox
# environments only. NODE_ENV=production refuses to start with this set.
# Leave unset in any deployed environment.
HARD_HARNESS_LOCAL_DEV_BYPASS_AUTH=""

# AUDIT_BYPASS_TOKEN=""
